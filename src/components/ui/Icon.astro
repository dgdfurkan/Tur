  mute: 'M4 10v4h3l5 4V6L7 10H4ZM16 9.5l5 5M21 9.5l-5 5',
  bus: 'M5 5h14a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1ZM4 11h16M8 17v2M16 17v2M7.5 14h1M15.5 14h1',
  shield: 'M12 3 5 6v5c0 4.5 3 8.2 7 10 4-1.8 7-5.5 7-10V6l-7-3ZM9 12l2 2 4-4.5',
