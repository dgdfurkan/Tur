---
import { ICON_PATHS, type IconName } from '@/shared/icons';

export type { IconName };

/**
 * A line icon. Icons are decorative by default; pass `label` when an icon is
 * the only content of a control.
 */
interface Props {
  name: IconName;
  size?: number;
  label?: string;
}

const { name, size = 20, label } = Astro.props;
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <path d={ICON_PATHS[name]}></path>
</svg>

<style>
  .icon {
    flex: none;
  }
</style>
