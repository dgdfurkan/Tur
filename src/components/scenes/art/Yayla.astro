---
import { ink } from '../palette';
import Cloud from '../parts/Cloud.astro';
import Pine from '../parts/Pine.astro';
---

<rect width="320" height="200" fill={ink.skyDay}></rect>
<Cloud x={250} y={30} scale={1.1} />
<!-- High peaks -->
<path d="M0 118l54-72 40 44 46-64 50 58 40-40 90 74z" fill={ink.farBlue}></path>
<path
  d="M54 46l14 20-12-6-10 12zM140 26l16 22-14-7-12 14zM230 42l14 16-12-5-10 10z"
  fill={ink.foam}
></path>
<!-- Forest belt under the peaks -->
<path d="M0 104q80-16 160-4t160-10v50H0z" fill={ink.forestDeep}></path>
<Pine x={20} y={124} height={46} fill={ink.forest} />
<Pine x={50} y={122} height={38} fill={ink.forest} />
<Pine x={270} y={122} height={42} fill={ink.forest} />
<Pine x={300} y={126} height={50} fill={ink.forest} />
<rect x="0" y="106" width="320" height="9" rx="4.5" fill={ink.cloud} opacity="0.55"></rect>
<!-- Meadow -->
<path d="M0 124q160-24 320 0v76H0z" fill={ink.grass}></path>
<path d="M0 162q160-20 320 4v34H0z" fill={ink.grassDeep}></path>
<!-- Timber chalets on stone footings -->
<g>
  <rect x="62" y="118" width="58" height="28" fill={ink.wood}></rect>
  <rect x="62" y="140" width="58" height="8" fill={ink.cliff}></rect>
  <path d="M52 120l39-26 39 26z" fill={ink.woodDeep}></path>
  <g fill={ink.lit}>
    <rect x="70" y="124" width="9" height="9"></rect>
    <rect x="103" y="124" width="9" height="9"></rect>
  </g>
  <rect x="86" y="128" width="10" height="20" fill={ink.dark}></rect>
  <rect x="184" y="126" width="48" height="24" fill={ink.wood}></rect>
  <rect x="184" y="144" width="48" height="7" fill={ink.cliff}></rect>
  <path d="M176 128l32-22 32 22z" fill={ink.woodDeep}></path>
  <rect x="192" y="132" width="8" height="8" fill={ink.lit}></rect>
  <rect x="212" y="132" width="9" height="18" fill={ink.dark}></rect>
</g>
<!-- Fence and cattle -->
<g fill={ink.woodDeep}>
  <rect x="130" y="158" width="160" height="2.5"></rect>
  <rect x="130" y="166" width="160" height="2.5"></rect>
  <rect x="134" y="154" width="3" height="18"></rect>
  <rect x="172" y="154" width="3" height="18"></rect>
  <rect x="210" y="154" width="3" height="18"></rect>
  <rect x="248" y="154" width="3" height="18"></rect>
  <rect x="286" y="154" width="3" height="18"></rect>
</g>
<g>
  <rect x="34" y="170" width="24" height="12" rx="5" fill={ink.wall}></rect>
  <rect x="54" y="166" width="10" height="9" rx="4" fill={ink.wall}></rect>
  <rect x="38" y="180" width="3" height="8" fill={ink.dark}></rect>
  <rect x="52" y="180" width="3" height="8" fill={ink.dark}></rect>
  <ellipse cx="44" cy="174" rx="5" ry="3.5" fill={ink.dark}></ellipse>
</g>
