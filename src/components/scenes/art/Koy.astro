  </g>
</g>
<Tree x={44} y={140} size={11} fill={ink.grassDeep} />
<Tree x={292} y={128} size={12} fill={ink.grassDeep} />
<Tree x={94} y={150} size={9} fill={ink.forest} />
<!-- Vineyard rows in front -->
<path d="M0 160q160-20 320 0v40H0z" fill={ink.steppe}></path>
