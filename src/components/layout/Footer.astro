---
import Coach from '@/components/scenes/parts/Coach.astro';
import BrandMark from '@/components/ui/BrandMark.astro';
import { tourCatalog } from '@/composition/catalog';
import { pageUrl } from '@/config/paths';
import { siteConfig } from '@/config/site';
import { tr } from '@/i18n/tr';
import { mailHref, telHref, whatsappHref } from '@/shared/contactLinks';

const year = new Date().getFullYear();
const tours = await tourCatalog.listTours();
// The operations panel is for staff: no public page links to it.
const pages = [
  { href: pageUrl('takvim'), label: tr.calendar.title },
  { href: pageUrl('gecmis-turlar'), label: tr.nav.pastTours },
  { href: pageUrl('kurumsal'), label: tr.nav.corporate },
  { href: pageUrl('sss'), label: tr.nav.faq },
  { href: pageUrl('iletisim'), label: tr.nav.contact },
];

const { contact, license } = siteConfig;
const channels = [
  {
    channel: 'phone',
    label: tr.contact.phone,
    value: contact.phone,
    href: contact.phone ? telHref(contact.phone) : null,
  },
  {
    channel: 'whatsapp',
    label: tr.contact.whatsapp,
    value: contact.whatsapp,
    href: contact.whatsapp ? whatsappHref(contact.whatsapp) : null,
  },
  {
    channel: 'email',
    label: tr.contact.email,
    value: contact.email,
    href: contact.email ? mailHref(contact.email) : null,
  },
] as const;
---

<footer class="site-footer">
  <div class="road" aria-hidden="true">
    <div class="lane"></div>
    <div class="road__coach">
      <Coach />
    </div>
  </div>
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <span class="brand">
        <BrandMark />
        <span class="brand__name" data-site-text="brandName">
          {siteConfig.brand.name}
        </span>
      </span>
      <p class="site-footer__about">{siteConfig.brand.description}</p>
      <p
        class="site-footer__license"
        data-tursab
        data-label={tr.contact.tursab('').trim()}
        data-pending={tr.footer.licensePending}
      >
        {license.tursabNumber ? tr.contact.tursab(license.tursabNumber) : tr.footer.licensePending}
      </p>
    </div>

    <nav class="site-footer__column" aria-labelledby="alt-turlar">
      <h2 id="alt-turlar">{tr.nav.tours}</h2>
      <ul>
        {tours.map((tour) => (
          <li data-tour-card={tour.id}>
            <a href={pageUrl(`turlar/${tour.id}`)}>{tour.title}</a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="site-footer__column" aria-labelledby="alt-bilgi">
      <h2 id="alt-bilgi">{tr.nav.information}</h2>
      <ul>
        {pages.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-footer__column">
      <h2>{tr.nav.contact}</h2>
      <dl class="site-footer__contact">
        {channels.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>
              <a data-contact-link={item.channel} href={item.href ?? undefined}>
                <span data-contact-value={item.channel} data-pending={tr.contact.pending}>
                  {item.value ?? tr.contact.pending}
                </span>
              </a>
            </dd>
          </div>
        ))}
        <div>
          <dt>{tr.contact.address}</dt>
          <dd data-contact-value="address" data-pending={tr.contact.pending}>
            {contact.address ?? tr.contact.pending}
          </dd>
        </div>
      </dl>
    </div>

    <div class="site-footer__legal">
      {siteConfig.isPrototype && <p>{tr.footer.prototypeNote}</p>}
      <p>
        © {year} <span data-site-text="brandName">{siteConfig.brand.name}</span>. {tr.footer.rights}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--c-asphalt);
    color: var(--c-white);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  /* The footer is the road itself, seen from the side, with its centre line. */
  .road {
    position: relative;
    margin-inline: var(--gutter);
  }

  .lane {
    height: 0.25rem;
    transform: translateY(2.5rem);
    background: repeating-linear-gradient(
      90deg,
      rgb(255 255 255 / 0.55) 0 2.5rem,
      transparent 2.5rem 4.5rem
    );
  }

  /* The coach has reached the end of the road and is parked there. */
  .road__coach {
    position: absolute;
    top: 0.625rem;
    right: 0;
    width: 6.25rem;
  }

  /* Where the browser can tie motion to scrolling, the coach drives in as the footer comes into view. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .site-footer {
        view-timeline-name: --footer;
      }

      .road__coach {
        /* Longhands on purpose: the minifier folds a timeline into the shorthand, which browsers reject. */
        animation-name: coach-arrives;
        animation-timing-function: ease-out;
        animation-fill-mode: both;
        animation-timeline: --footer;
        animation-range: entry 0% entry 100%;
      }

      .road__coach :global(.coach__wheel) {
        animation-name: coach-rolls;
        animation-timing-function: ease-out;
        animation-fill-mode: both;
        animation-timeline: --footer;
        animation-range: entry 0% entry 100%;
      }

      @keyframes coach-arrives {
        from {
          transform: translateX(calc(-100vw + var(--gutter)));
        }
      }

      @keyframes coach-rolls {
        from {
          transform: rotate(-1800deg);
        }
      }
    }
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-9) var(--space-7);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  .brand__name {
    font-stretch: var(--wdth-heading);
    font-weight: 750;
    font-size: 1.25rem;
  }

  .site-footer__about {
    max-width: 38ch;
    margin-top: var(--space-4);
    color: rgb(255 255 255 / 0.78);
    font-size: var(--text-small);
  }

  .site-footer__license {
    margin-top: var(--space-3);
    color: rgb(255 255 255 / 0.66);
    font-size: var(--text-small);
  }

  .site-footer__column h2 {
    margin-bottom: var(--space-3);
    color: rgb(255 255 255 / 0.66);
    font-size: var(--text-small);
    font-stretch: var(--wdth-sign);
    font-weight: 650;
    letter-spacing: 0;
  }

  .site-footer__column ul {
    display: grid;
  }

  .site-footer__column a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    font-weight: 550;
    text-decoration: none;
  }

  .site-footer__contact {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  .site-footer__contact dt {
    color: rgb(255 255 255 / 0.66);
    font-size: var(--text-caption);
  }

  .site-footer__contact dd {
    margin: 0;
    font-weight: 550;
  }

  /* Without the detail yet the line is a note, not a link. */
  .site-footer__contact a:not([href]),
  .site-footer__contact [data-empty],
  .site-footer__contact dd[data-contact-value] {
    min-height: 0;
    color: rgb(255 255 255 / 0.78);
    font-weight: 400;
  }

  .site-footer__legal {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-5);
    border-top: 1px solid rgb(255 255 255 / 0.14);
    color: rgb(255 255 255 / 0.66);
    font-size: var(--text-small);
  }

  .site-footer__legal p {
    max-width: 62ch;
  }

  .site-footer :focus-visible {
    outline-color: var(--c-white);
  }

  @media (hover: hover) and (pointer: fine) {
    .site-footer__column a[href]:hover {
      text-decoration: underline;
    }
  }

  @media (min-width: 40rem) {
    .site-footer__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .site-footer__brand,
    .site-footer__legal {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64rem) {
    .site-footer__inner {
      grid-template-columns: minmax(0, 1.3fr) repeat(3, minmax(0, 1fr));
      gap: var(--space-7) var(--space-6);
    }

    .site-footer__brand {
      grid-column: auto;
    }
  }
</style>
