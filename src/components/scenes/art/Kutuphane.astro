---
import { ink } from '../palette';
import Cloud from '../parts/Cloud.astro';
import Poplar from '../parts/Poplar.astro';
---

<rect width="320" height="200" fill={ink.skyDay}></rect>
<Cloud x={48} y={30} scale={1} />
<path d="M0 120q80-20 160-10t160-14v60H0z" fill={ink.farGreen}></path>
<Poplar x={30} y={158} height={70} fill={ink.forest} />
<Poplar x={294} y={158} height={62} fill={ink.forest} />
<!-- Back wall -->
<rect x="64" y="40" width="192" height="116" fill={ink.stoneShade}></rect>
<!-- Upper storey -->
<g>
  <g fill={ink.marble}>
    <path d="M70 58l20-12 20 12z"></path>
    <path d="M140 58q20-16 40 0z"></path>
    <path d="M210 58l20-12 20 12z"></path>
    <rect x="68" y="58" width="44" height="5"></rect>
    <rect x="138" y="58" width="44" height="5"></rect>
    <rect x="208" y="58" width="44" height="5"></rect>
    <rect x="72" y="63" width="6" height="34"></rect>
    <rect x="102" y="63" width="6" height="34"></rect>
    <rect x="142" y="63" width="6" height="34"></rect>
    <rect x="172" y="63" width="6" height="34"></rect>
    <rect x="212" y="63" width="6" height="34"></rect>
    <rect x="242" y="63" width="6" height="34"></rect>
  </g>
  <g fill={ink.stoneDeep}>
    <rect x="84" y="70" width="12" height="22"></rect>
    <rect x="154" y="70" width="12" height="22"></rect>
    <rect x="224" y="70" width="12" height="22"></rect>
  </g>
</g>
<rect x="60" y="97" width="200" height="7" fill={ink.marble}></rect>
<!-- Lower storey -->
<g>
  <g fill={ink.marble}>
    <rect x="70" y="104" width="7" height="46"></rect>
    <rect x="88" y="104" width="7" height="46"></rect>
    <rect x="122" y="104" width="7" height="46"></rect>
    <rect x="140" y="104" width="7" height="46"></rect>
    <rect x="173" y="104" width="7" height="46"></rect>
    <rect x="191" y="104" width="7" height="46"></rect>
    <rect x="225" y="104" width="7" height="46"></rect>
    <rect x="243" y="104" width="7" height="46"></rect>
  </g>
  <g fill={ink.dark}>
    <rect x="100" y="116" width="17" height="34"></rect>
    <rect x="151" y="110" width="18" height="40"></rect>
    <rect x="203" y="116" width="17" height="34"></rect>
  </g>
</g>
<!-- Podium and steps -->
<rect x="56" y="150" width="208" height="8" fill={ink.marble}></rect>
<rect x="46" y="158" width="228" height="7" fill={ink.marbleShade}></rect>
<rect x="36" y="165" width="248" height="7" fill={ink.marble}></rect>
<rect x="0" y="172" width="320" height="28" fill={ink.marbleShade}></rect>
<g fill="none" stroke={ink.marble} stroke-width="1.5">
  <path d="M0 184h320M40 172v12M100 172v12M160 172v12M220 172v12M280 172v12M70 184v16M130 184v16M190 184v16M250 184v16"></path>
</g>
