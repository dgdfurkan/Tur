---
import { ink } from '../palette';
import Cloud from '../parts/Cloud.astro';
---

<rect width="320" height="200" fill={ink.skyDay}></rect>
<Cloud x={70} y={30} scale={1.1} />
<path d="M0 70q90-22 180-10t140-14v60H0z" fill={ink.farSand}></path>
<!-- Terraces stepping down the slope -->
<path d="M0 84q160-26 320 0v116H0z" fill={ink.marble}></path>
<g>
  <path
    d="M150 70c20-8 46-8 60 0s40 4 50 12c-16 10-48 6-64 10s-40-2-50-10c-6-5-4-9 4-12z"
    fill={ink.foam}
  ></path>
  <path
    d="M158 74c16-6 38-6 50 0s32 3 40 8c-14 6-40 4-52 6s-32-2-40-7c-4-3-3-5 2-7z"
    fill={ink.pool}
  ></path>
  <path
    d="M60 96c26-10 60-10 80-2s56 4 70 14c-20 12-64 8-86 12s-56-2-70-12c-8-5-6-9 6-12z"
    fill={ink.foam}
  ></path>
  <path
    d="M70 100c22-8 50-8 66-2s48 4 60 11c-18 8-54 6-72 9s-46-2-58-9c-6-4-5-7 4-9z"
    fill={ink.pool}
  ></path>
  <path
    d="M190 116c24-8 56-8 74 0s44 6 56 14v6c-22 8-58 4-78 8s-52-4-64-12c-8-6-4-12 12-16z"
    fill={ink.foam}
  ></path>
  <path
    d="M200 120c20-6 46-6 62 0s38 5 50 11c-20 6-50 4-68 7s-44-3-54-9c-6-4-3-7 10-9z"
    fill={ink.pool}
  ></path>
  <path
    d="M0 132c30-10 70-10 96 0s60 6 76 16c-24 12-72 8-98 12s-54-4-74-10z"
    fill={ink.foam}
  ></path>
  <path d="M0 138c28-8 62-8 86 0s54 5 68 12c-22 8-64 6-88 9s-48-3-66-8z" fill={ink.pool}></path>
  <path d="M120 164c28-10 70-10 96 0s72 8 104 14v22H104c-10-16-6-28 16-36z" fill={ink.foam}></path>
  <path d="M132 170c24-8 60-8 84 0s64 7 104 13v17H120c-8-14-6-24 12-30z" fill={ink.pool}></path>
</g>
<!-- Lime drips between the pools -->
<g fill="none" stroke={ink.marbleShade} stroke-width="1.6" stroke-linecap="round">
  <path d="M170 92v10M184 94v8M198 93v12M88 122v12M104 124v8M126 122v14M232 142v12M252 144v9M276 142v14M40 160v14M62 162v10"></path>
</g>
<!-- Barefoot visitors -->
<g fill={ink.dark}>
  <circle cx="112" cy="96" r="2.6"></circle>
  <rect x="109.8" y="99" width="4.4" height="9" rx="2"></rect>
  <circle cx="122" cy="98" r="2.4"></circle>
  <rect x="120" y="101" width="4" height="8" rx="2"></rect>
</g>
