---
import OccupancyMeter from './OccupancyMeter.astro';
import Scene from '@/components/scenes/Scene.astro';
import Emblem from '@/components/ui/Emblem.astro';
import { pageUrl } from '@/config/paths';
import type { Departure } from '@/domain/tour/Departure';
import type { Tour } from '@/domain/tour/Tour';
import { categoryLabels, tr } from '@/i18n/tr';
import { formatDateRange, formatDuration, formatMoney, formatTime } from '@/shared/format';

/**
 * A tour as a ticket: a picture of where it goes, the journey, and a fare stub
 * that tears off along a perforation. The page that shows tickets must include
 * the pictures themselves with <SceneSprite>.
 */
interface Props {
  tour: Tour;
  departure?: Departure | undefined;
  headingLevel?: 'h2' | 'h3';
}

const { tour, departure, headingLevel: Heading = 'h3' } = Astro.props;
const tourUrl = pageUrl(`turlar/${tour.id}`);
---

<article class="ticket" data-category={tour.category} data-tilt>
  <div class="ticket__art">
    <div class="ticket__picture">
      <Scene scene={tour.scene} />
    </div>
    <p class="ticket__category">
      <Emblem name={tour.emblem} size={20} />
      {categoryLabels[tour.category]}
    </p>
    {
      // A day trip already says so in its category sign.
      !tour.isDayTrip && (
        <p class="ticket__duration">{formatDuration(tour.nights, tour.dayCount)}</p>
      )
    }
  </div>

  <div class="ticket__main">
    <Heading class="ticket__title">
      <a href={tourUrl}>{tour.title}</a>
    </Heading>
    <dl class="ticket__facts">
      <div>
        <dt>{tr.tour.nextDeparture}</dt>
        <dd>
          {departure
            ? formatDateRange(departure.startDate, departure.endDate)
            : tr.tour.noDepartures}
        </dd>
      </div>
      {departure && (
        <div>
          <dt>{tr.tour.departureTime}</dt>
          <dd class="tabular">{formatTime(departure.time)}</dd>
        </div>
      )}
    </dl>
  </div>

  <div class="ticket__stub">
    <p class="ticket__price">
      <span class="ticket__price-label">{tr.tour.perPerson}</span>
      <strong class="tabular" data-price-for={tour.id}>
        {formatMoney(tour.price)}
      </strong>
    </p>
    {departure && <OccupancyMeter occupancy={departure.occupancy} departureId={departure.id} />}
  </div>
</article>

<style>
  .ticket {
    --cut: var(--section-bg, var(--c-white));
    --notch: 0.75rem;
    /* Set by the pointer on devices that have one; the ticket leans towards it. */
    --tilt-x: 0;
    --tilt-y: 0;
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100%;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    background: var(--c-white);
    box-shadow: var(--shadow-1);
    transform: perspective(60rem) rotateX(calc(var(--tilt-y) * -5deg))
      rotateY(calc(var(--tilt-x) * 7deg));
    transition:
      transform 500ms var(--ease-out),
      box-shadow var(--dur-ui) ease;
  }

  .ticket__art {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: calc(var(--radius-lg) - 1px) calc(var(--radius-lg) - 1px) 0 0;
    overflow: hidden;
  }

  /* A little larger than its frame, so it can shift against the pointer without showing an edge. */
  .ticket__picture {
    position: absolute;
    inset: -4%;
    transform: translate(calc(var(--tilt-x) * -3%), calc(var(--tilt-y) * -3%));
    transition: transform 500ms var(--ease-out);
  }

  /* A brown tourist sign names the kind of tour. */
  .ticket__category {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.1875rem var(--space-3) 0.1875rem var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--c-brown);
    box-shadow:
      inset 0 0 0 0.0625rem var(--c-white),
      0 0 0 0.125rem var(--c-brown),
      0 2px 6px rgb(27 31 36 / 0.3);
    color: var(--c-white);
    font-stretch: var(--wdth-sign);
    font-size: var(--text-small);
    font-weight: 650;
  }

  .ticket__duration {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    padding: 0.0625rem var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--c-asphalt);
    color: var(--c-white);
    font-stretch: var(--wdth-sign);
    font-size: var(--text-caption);
    font-weight: 650;
  }

  .ticket__main {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    padding: var(--space-5);
  }

  .ticket__title {
    font-size: var(--text-h3);
  }

  /* The whole ticket is one target; the link stretches over it. */
  .ticket__title a {
    text-decoration: none;
  }

  .ticket__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }

  .ticket__facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-4);
    margin: 0;
  }

  .ticket__facts dt,
  .ticket__price-label {
    display: block;
    color: var(--c-muted);
    font-size: var(--text-caption);
  }

  .ticket__facts dd {
    margin: 0;
    font-weight: 600;
  }

  .ticket__stub {
    position: relative;
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5) var(--space-5);
    border-top: 0.125rem dashed var(--c-line);
  }

  /* Punched notches where the stub tears off. */
  .ticket__stub::before,
  .ticket__stub::after {
    content: '';
    position: absolute;
    top: calc(var(--notch) * -1 - 1px);
    width: calc(var(--notch) * 2);
    height: calc(var(--notch) * 2);
    border: 1px solid var(--c-line);
    border-radius: 50%;
    background: var(--cut);
  }

  .ticket__stub::before {
    left: calc(var(--notch) * -1 - 1px);
    clip-path: inset(0 0 0 50%);
  }

  .ticket__stub::after {
    right: calc(var(--notch) * -1 - 1px);
    clip-path: inset(0 50% 0 0);
  }

  .ticket__price strong {
    display: block;
    font-stretch: var(--wdth-heading);
    font-size: 1.75rem;
    font-weight: 750;
    line-height: 1.1;
  }

  .ticket:has(a:active) {
    transform: scale(0.99);
  }

  .ticket:has(a:focus-visible) {
    outline: 3px solid var(--c-blue);
    outline-offset: 3px;
  }

  .ticket__title a:focus-visible {
    outline: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .ticket:hover {
      box-shadow: var(--shadow-2);
    }

    /* While the pointer is over the ticket it follows closely; on leaving it settles back slowly. */
    .ticket:hover,
    .ticket:hover .ticket__picture {
      transition-duration: 140ms, var(--dur-ui);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticket,
    .ticket__picture {
      transform: none;
    }
  }
</style>
