---
/** A hot-air balloon; `x` and `y` are the centre of its envelope. */
interface Props {
  x: number;
  y: number;
  scale?: number;
  fill?: string;
  stripe?: string;
}

const { x, y, scale = 1, fill = '#e4572e', stripe = '#ffffff' } = Astro.props;
---

<g transform={`translate(${x} ${y}) scale(${scale})`}>
  <path
    d="M0 -14c8.5 0 13 6 13 12 0 7-7 11-9.5 17h-7C-6 9-13 5-13-2c0-6 4.5-12 13-12z"
    fill={fill}
  ></path>
  <path
    d="M0 -14c3 0 4.5 6 4.5 12 0 7-2 11-3 17h-3c-1-6-3-10-3-17 0-6 1.5-12 4.5-12z"
    fill={stripe}
    opacity="0.85"
  ></path>
  <rect x="-3" y="17" width="6" height="4.5" rx="1" fill="#553c28"></rect>
</g>
