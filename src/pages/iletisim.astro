---
import FaqList from '@/components/faq/FaqList.astro';
import PageHead from '@/components/layout/PageHead.astro';
import Button from '@/components/ui/Button.astro';
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import Steps from '@/components/ui/Steps.astro';
import { loadFaq } from '@/composition/catalog';
import { pageUrl } from '@/config/paths';
import { siteConfig } from '@/config/site';
import { tr } from '@/i18n/tr';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  instagramHref,
  instagramName,
  mailHref,
  telHref,
  whatsappHref,
} from '@/shared/contactLinks';

const { contact } = siteConfig;
const greeting = tr.booking.generalMessage;

const channels: {
  channel: 'phone' | 'whatsapp' | 'email';
  icon: IconName;
  label: string;
  value: string | null;
  href: string | null;
  action: string;
  message?: string;
}[] = [
  {
    channel: 'phone',
    icon: 'phone',
    label: tr.contact.phone,
    value: contact.phone,
    href: contact.phone ? telHref(contact.phone) : null,
    action: tr.actions.call,
  },
  {
    channel: 'whatsapp',
    icon: 'message',
    label: tr.contact.whatsapp,
    value: contact.whatsapp,
    href: contact.whatsapp ? whatsappHref(contact.whatsapp, greeting) : null,
    action: tr.actions.whatsapp,
    message: greeting,
  },
  {
    channel: 'email',
    icon: 'mail',
    label: tr.contact.email,
    value: contact.email,
    href: contact.email ? mailHref(contact.email) : null,
    action: tr.actions.email,
  },
];

const office: {
  channel: 'address' | 'hours';
  icon: IconName;
  label: string;
  value: string | null;
}[] = [
  { channel: 'address', icon: 'pin', label: tr.contact.address, value: contact.address },
  { channel: 'hours', icon: 'clock', label: tr.contact.hours, value: contact.hours },
];
const instagram = contact.instagram ? instagramHref(contact.instagram) : null;
const featured = (await loadFaq()).filter((question) => question.featured);
---

<BaseLayout
  title={tr.nav.contact}
  description="Rezervasyon, teklif ve sorular için ofisin telefon, WhatsApp, e-posta ve adres bilgileri."
>
  <PageHead
    title={tr.nav.contact}
    lead="Rezervasyon, teklif ve sorularınız için ofisimize telefonla, WhatsApp üzerinden veya e-postayla ulaşabilirsiniz."
  />

  <section class="container reach" aria-labelledby="kanallar">
    <h2 id="kanallar" class="visually-hidden">
      {tr.contact.channels}
    </h2>
    <ul class="channels">
      {channels.map((item) => (
        <li class="channel" data-reveal>
          <span class="channel__icon">
            <Icon name={item.icon} size={26} />
          </span>
          <h3>{item.label}</h3>
          <p
            class="channel__value"
            data-contact-value={item.channel}
            data-pending={tr.contact.pending}
            data-empty={item.value ? undefined : ''}
          >
            {item.value ?? tr.contact.pending}
          </p>
          <Button
            href={item.href ?? undefined}
            link
            variant={item.channel === 'phone' ? 'primary' : 'secondary'}
            target={item.channel === 'whatsapp' ? '_blank' : undefined}
            hidden={!item.href}
            data-contact-link={item.channel}
            data-message={item.message}
            data-hide-empty=""
          >
            {item.action}
          </Button>
        </li>
      ))}
    </ul>

    <div class="office">
      <h2>{tr.contact.office}</h2>
      <dl class="office__list">
        {office.map((item) => (
          <div>
            <dt>
              <Icon name={item.icon} size={20} />
              {item.label}
            </dt>
            <dd
              data-contact-value={item.channel}
              data-pending={tr.contact.pending}
              data-empty={item.value ? undefined : ''}
            >
              {item.value ?? tr.contact.pending}
            </dd>
          </div>
        ))}
        <div>
          <dt>
            <Icon name="image" size={20} />
            {tr.contact.instagram}
          </dt>
          <dd>
            <a
              data-contact-link="instagram"
              href={instagram ?? undefined}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span
                data-contact-value="instagram"
                data-pending={tr.contact.pending}
                data-empty={contact.instagram ? undefined : ''}
              >
                {contact.instagram ? instagramName(contact.instagram) : tr.contact.pending}
              </span>
            </a>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section section--mist" aria-labelledby="nasil">
    <div class="container">
      <h2 id="nasil" class="section-title">
        {tr.booking.title}
      </h2>
      <Steps steps={tr.booking.steps} />
    </div>
  </section>

  <section class="section container" aria-labelledby="sorular">
    <div class="questions">
      <div class="questions__head">
        <h2 id="sorular">{tr.faq.title}</h2>
        <Button href={pageUrl('sss')} variant="secondary">
          {tr.actions.allQuestions}
        </Button>
      </div>
      <FaqList items={featured} name="iletisim-sss" show="featured" />
    </div>
  </section>
</BaseLayout>

<style>
  .reach {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-6) var(--space-section);
  }

  .channels {
    display: grid;
    gap: var(--space-4);
  }

  .channel {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    background: var(--c-white);
    box-shadow: var(--shadow-1);
  }

  /* Blue, with the white rim of a road sign. */
  .channel__icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius-md);
    background: var(--c-blue);
    box-shadow:
      inset 0 0 0 0.1875rem var(--c-blue),
      inset 0 0 0 0.3125rem var(--c-white);
    color: var(--c-white);
  }

  .channel h3 {
    font-size: 1.25rem;
  }

  .channel__value {
    font-stretch: var(--wdth-heading);
    font-size: 1.375rem;
    font-weight: 700;
  }

  .channel__value[data-empty] {
    color: var(--c-muted);
    font-size: var(--text-body);
    font-weight: 400;
  }

  .office {
    display: grid;
    gap: var(--space-4);
  }

  .office h2 {
    font-size: var(--text-h3);
  }

  .office__list {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--c-line);
  }

  .office__list > div {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--c-line);
  }

  .office__list dt {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: 650;
  }

  .office__list dt :global(svg) {
    color: var(--c-blue);
  }

  .office__list dd {
    margin: 0;
  }

  .office__list [data-empty] {
    color: var(--c-muted);
  }

  .office__list a[href] {
    color: var(--c-blue);
    font-weight: 600;
  }

  .office__list a:not([href]) {
    text-decoration: none;
  }

  .section-title {
    margin-bottom: var(--space-7);
  }

  .questions {
    display: grid;
    gap: var(--space-6);
  }

  .questions__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
  }

  @media (min-width: 48rem) {
    .channels {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .office__list > div {
      grid-template-columns: 14rem 1fr;
      align-items: center;
    }
  }
</style>
