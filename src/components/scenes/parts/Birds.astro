---
/** A few birds in flight around the point (`x`, `y`). */
interface Props {
  x: number;
  y: number;
  stroke?: string;
}

const { x, y, stroke = '#55606b' } = Astro.props;
---

<g fill="none" stroke={stroke} stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
  <path d={`M${x} ${y}q3-3 6 0q3-3 6 0`}></path>
  <path d={`M${x + 16} ${y - 7}q2.5-2.5 5 0q2.5-2.5 5 0`}></path>
  <path d={`M${x - 12} ${y - 5}q2-2 4 0q2-2 4 0`}></path>
</g>
