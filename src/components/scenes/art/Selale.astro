---
import { ink } from '../palette';
import Cloud from '../parts/Cloud.astro';
import Pine from '../parts/Pine.astro';
---

<rect width="320" height="200" fill={ink.skyDay}></rect>
<Cloud x={60} y={26} scale={1} />
<!-- Rock face -->
<path d="M60 200V50q40-34 100-30t100 34v146z" fill={ink.forest}></path>
<path d="M120 40h80l14 160h-108z" fill={ink.cliff}></path>
<path d="M176 40h24l14 160h-30q6-90-8-160z" fill={ink.cliffShade}></path>
<!-- The fall, split into strands like a veil -->
<path d="M146 36q14-6 28 0l10 124q-24 8-48 0z" fill={ink.foam}></path>
<g fill="none" stroke={ink.water} stroke-width="1.8" stroke-linecap="round" opacity="0.75">
  <path d="M152 44l-6 110M160 42l-2 116M168 44l4 112M174 50l6 100"></path>
</g>
<!-- Pool and spray -->
<ellipse cx="160" cy="166" rx="46" ry="12" fill={ink.water}></ellipse>
<g fill={ink.foam} opacity="0.9">
  <circle cx="142" cy="160" r="7"></circle>
  <circle cx="160" cy="164" r="9"></circle>
  <circle cx="178" cy="160" r="7"></circle>
</g>
<Pine x={84} y={150} height={70} fill={ink.forestDeep} />
<Pine x={104} y={162} height={50} fill={ink.grassDeep} />
<Pine x={232} y={152} height={74} fill={ink.forestDeep} />
<Pine x={216} y={164} height={48} fill={ink.grassDeep} />
<!-- Meadow with a chalet -->
<path d="M0 160q80-20 160 10t160-14v44H0z" fill={ink.grass}></path>
<g>
  <rect x="254" y="150" width="40" height="22" fill={ink.wood}></rect>
  <path d="M248 152l26-18 26 18z" fill={ink.woodDeep}></path>
  <rect x="262" y="158" width="8" height="8" fill={ink.lit}></rect>
  <rect x="278" y="158" width="8" height="14" fill={ink.dark}></rect>
</g>
<path d="M120 176q40-8 80 0l10 24H112z" fill={ink.water}></path>
