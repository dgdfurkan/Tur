---
import { ink } from '../palette';
import Cloud from '../parts/Cloud.astro';
import Tree from '../parts/Tree.astro';
---

<rect width="320" height="200" fill={ink.skyDay}></rect>
<circle cx="262" cy="40" r="17" fill={ink.sunPale}></circle>
<Cloud x={70} y={38} scale={1.2} />
<Cloud x={190} y={58} scale={0.8} />
<!-- Far skyline -->
<g fill={ink.farBlue}>
  <rect x="0" y="96" width="34" height="50"></rect>
  <rect x="38" y="80" width="26" height="66"></rect>
  <rect x="68" y="102" width="40" height="44"></rect>
  <rect x="112" y="72" width="22" height="74"></rect>
  <rect x="138" y="92" width="36" height="54"></rect>
  <rect x="254" y="86" width="30" height="60"></rect>
  <rect x="288" y="100" width="32" height="46"></rect>
</g>
<!-- Atakule -->
<g>
  <rect x="211" y="58" width="8" height="88" fill={ink.marbleShade}></rect>
  <path d="M198 58h34l-6 -12h-22z" fill={ink.marble}></path>
  <rect x="202" y="40" width="26" height="6" rx="3" fill={ink.blue}></rect>
  <rect x="207" y="33" width="16" height="7" rx="3" fill={ink.marble}></rect>
  <rect x="214" y="14" width="2" height="19" fill={ink.marbleShade}></rect>
</g>
<!-- Near buildings -->
<g>
  <rect x="18" y="108" width="52" height="40" fill={ink.wall}></rect>
  <rect x="70" y="118" width="46" height="30" fill={ink.wallShade}></rect>
  <rect x="236" y="112" width="58" height="36" fill={ink.wall}></rect>
  <g fill={ink.farBlue}>
    <rect x="25" y="114" width="7" height="7"></rect>
    <rect x="38" y="114" width="7" height="7"></rect>
    <rect x="51" y="114" width="7" height="7"></rect>
    <rect x="25" y="127" width="7" height="7"></rect>
    <rect x="38" y="127" width="7" height="7"></rect>
    <rect x="51" y="127" width="7" height="7"></rect>
    <rect x="244" y="119" width="8" height="7"></rect>
    <rect x="259" y="119" width="8" height="7"></rect>
    <rect x="274" y="119" width="8" height="7"></rect>
  </g>
</g>
<Tree x={130} y={148} size={13} />
<Tree x={300} y={148} size={12} fill={ink.grassDeep} />
<!-- Boulevard and the waiting coach -->
<rect x="0" y="148" width="320" height="52" fill={ink.asphalt}></rect>
<rect x="0" y="148" width="320" height="5" fill={ink.marbleShade}></rect>
<g fill={ink.line} opacity="0.9">
  <rect x="14" y="180" width="30" height="3"></rect>
  <rect x="78" y="180" width="30" height="3"></rect>
  <rect x="142" y="180" width="30" height="3"></rect>
  <rect x="206" y="180" width="30" height="3"></rect>
  <rect x="270" y="180" width="30" height="3"></rect>
</g>
<g>
  <rect x="146" y="132" width="84" height="32" rx="6" fill={ink.wall}></rect>
  <rect x="146" y="152" width="84" height="6" fill={ink.blue}></rect>
  <rect x="153" y="138" width="60" height="10" rx="2" fill={ink.glass}></rect>
  <rect x="218" y="137" width="9" height="14" rx="2" fill={ink.glass}></rect>
  <circle cx="165" cy="165" r="6" fill={ink.dark}></circle>
  <circle cx="212" cy="165" r="6" fill={ink.dark}></circle>
  <circle cx="165" cy="165" r="2.4" fill={ink.marbleShade}></circle>
  <circle cx="212" cy="165" r="2.4" fill={ink.marbleShade}></circle>
</g>
<!-- Stop sign -->
<rect x="250" y="118" width="2.5" height="34" fill={ink.marbleShade}></rect>
<rect x="243" y="106" width="17" height="15" rx="2" fill={ink.blue}></rect>
<rect x="247" y="110" width="9" height="7" rx="1" fill={ink.line}></rect>
