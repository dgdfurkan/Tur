---
import Icon from '@/components/ui/Icon.astro';
import type { Tour } from '@/domain/tour/Tour';
import { tr } from '@/i18n/tr';
import { formatMinutes } from '@/shared/format';

/** Day-by-day programme drawn as a road with its stops. */
interface Props {
  tour: Tour;
}

const { tour } = Astro.props;
---

<ol class="days">
  {tour.days.map((day) => (
    <li class="day">
      <div class="day__head">
        <p class="day__number">
          {day.number}. {tr.tour.day}
        </p>
        <h3>{day.title}</h3>
        <p class="day__summary">{day.summary}</p>
      </div>
      <ol class="stops">
        {day.stops.map((stop) => (
          <li class="stop" data-kind={stop.kind}>
            <span class="stop__marker" aria-hidden="true">
              {stop.kind === 'lodging' && <Icon name="bed" size={16} />}
            </span>
            <div class="stop__body">
              <h4>{stop.name}</h4>
              <p>{stop.summary}</p>
              {stop.durationMinutes !== undefined && (
                <p class="stop__duration">
                  <Icon name="clock" size={16} />
                  {formatMinutes(stop.durationMinutes)}
                </p>
              )}
            </div>
          </li>
        ))}
      </ol>
    </li>
  ))}
</ol>

<style>
  .days {
    display: grid;
    gap: var(--space-7);
  }

  .day {
    display: grid;
    gap: var(--space-5);
  }

  .day__number {
    display: inline-block;
    padding: 0.125rem var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--c-asphalt);
    color: var(--c-white);
    font-stretch: var(--wdth-sign);
    font-weight: 650;
    font-size: var(--text-small);
  }

  .day h3 {
    margin-top: var(--space-3);
  }

  .day__summary {
    margin-top: var(--space-2);
    color: var(--c-muted);
    max-width: 62ch;
  }

  .stops {
    --marker: 1.75rem;
    position: relative;
    display: grid;
    gap: var(--space-5);
  }

  /* The road the coach follows through the day. */
  .stops::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: calc(var(--marker) / 2 - 0.125rem);
    width: 0.25rem;
    border-radius: 0.125rem;
    background: var(--c-line);
  }

  .stop {
    position: relative;
    display: grid;
    grid-template-columns: var(--marker) 1fr;
    gap: var(--space-4);
  }

  .stop__marker {
    display: grid;
    place-items: center;
    width: var(--marker);
    height: var(--marker);
    border: 0.25rem solid var(--c-white);
    border-radius: 50%;
    background: var(--c-brown);
    color: var(--c-white);
    box-shadow: 0 0 0 0.0625rem var(--c-line);
  }

  .stop[data-kind='departure'] .stop__marker,
  .stop[data-kind='arrival'] .stop__marker {
    background: var(--c-blue);
  }

  .stop[data-kind='rest'] .stop__marker {
    background: var(--c-white);
    box-shadow: inset 0 0 0 0.1875rem var(--c-muted);
  }

  .stop[data-kind='lodging'] .stop__marker {
    border-width: 0;
    background: var(--c-asphalt);
  }

  .stop__body h4 {
    font-size: 1.125rem;
    font-stretch: var(--wdth-sign);
    line-height: 1.3;
  }

  .stop__body p {
    margin-top: var(--space-1);
    color: var(--c-muted);
    max-width: 62ch;
  }

  .stop__duration {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-small);
  }

  @media (min-width: 56rem) {
    .day {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--space-7);
    }

    .day__head {
      position: sticky;
      top: var(--space-5);
      align-self: start;
    }
  }
</style>
