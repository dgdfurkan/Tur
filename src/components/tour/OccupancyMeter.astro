---
import type { Occupancy } from '@/domain/tour/Occupancy';
import { formatPercent } from '@/shared/format';
import { tr } from '@/i18n/tr';

interface Props {
  occupancy: Occupancy;
  /** Lets the demo panel update the figures on the same device. */
  departureId?: string;
}

const { occupancy, departureId } = Astro.props;

const status =
  occupancy.level === 'full'
    ? tr.tour.soldOut
    : occupancy.level === 'limited'
      ? `Son ${occupancy.remaining} Koltuk`
      : `${tr.tour.remainingSeats}: ${occupancy.remaining}`;
---

<div
  class="meter"
  data-occupancy
  data-level={occupancy.level}
  data-departure-id={departureId}
  data-capacity={occupancy.capacity}
  data-booked={occupancy.booked}
>
  <div class="meter__labels">
    <span class="meter__percent tabular" data-occupancy-percent>
      {`${tr.tour.occupancy} ${formatPercent(occupancy.ratio)}`}
    </span>
    <span class="meter__status tabular" data-occupancy-status>
      {status}
    </span>
  </div>
  <svg class="meter__bar" viewBox="0 0 100 4" preserveAspectRatio="none" aria-hidden="true">
    <rect class="meter__track" width="100" height="4" rx="2"></rect>
    <rect
      class="meter__fill"
      data-occupancy-fill
      width={occupancy.percent}
      height="4"
      rx="2"
    ></rect>
  </svg>
</div>

<style>
  .meter {
    --level: var(--c-green);
    display: grid;
    gap: var(--space-2);
  }

  .meter[data-level='limited'] {
    --level: var(--c-yellow);
  }

  .meter[data-level='full'] {
    --level: var(--c-red);
  }

  .meter__labels {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--text-small);
  }

  .meter__percent {
    color: var(--c-muted);
  }

  .meter__status {
    font-weight: 650;
  }

  .meter[data-level='limited'] .meter__status {
    padding: 0.125rem var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--c-yellow);
  }

  .meter[data-level='full'] .meter__status {
    color: var(--c-red);
  }

  .meter__bar {
    width: 100%;
    height: 0.375rem;
    overflow: visible;
  }

  .meter__track {
    fill: var(--c-line);
  }

  .meter__fill {
    fill: var(--level);
    transition: width var(--dur-panel) var(--ease-out);
  }
</style>
