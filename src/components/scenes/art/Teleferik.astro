---
import { ink } from '../palette';
import Cloud from '../parts/Cloud.astro';
import Pine from '../parts/Pine.astro';
---

<rect width="320" height="200" fill={ink.skyDay}></rect>
<Cloud x={226} y={34} scale={1.2} />
<!-- Sea and the curve of the coast -->
<rect x="0" y="96" width="320" height="104" fill={ink.sea}></rect>
<path d="M0 96h320v10H0z" fill={ink.seaDeep} opacity="0.5"></path>
<path d="M120 200c10-40 60-70 110-78s70-16 90-14v92z" fill={ink.farGreen}></path>
<!-- Town along the shore -->
<g>
  <g fill={ink.wall}>
    <rect x="176" y="148" width="18" height="14"></rect>
    <rect x="200" y="140" width="16" height="16"></rect>
    <rect x="222" y="146" width="18" height="14"></rect>
    <rect x="246" y="134" width="16" height="18"></rect>
    <rect x="268" y="142" width="18" height="14"></rect>
    <rect x="292" y="132" width="16" height="18"></rect>
    <rect x="196" y="166" width="18" height="14"></rect>
    <rect x="224" y="170" width="18" height="14"></rect>
    <rect x="254" y="164" width="18" height="14"></rect>
    <rect x="284" y="168" width="18" height="14"></rect>
  </g>
  <g fill={ink.roof}>
    <rect x="174" y="145" width="22" height="4"></rect>
    <rect x="198" y="137" width="20" height="4"></rect>
    <rect x="220" y="143" width="22" height="4"></rect>
    <rect x="244" y="131" width="20" height="4"></rect>
    <rect x="266" y="139" width="22" height="4"></rect>
    <rect x="290" y="129" width="20" height="4"></rect>
    <rect x="194" y="163" width="22" height="4"></rect>
    <rect x="222" y="167" width="22" height="4"></rect>
    <rect x="252" y="161" width="22" height="4"></rect>
    <rect x="282" y="165" width="22" height="4"></rect>
  </g>
</g>
<!-- The hill the cabins climb -->
<path d="M0 60q50-30 90-10t60 70l40 80H0z" fill={ink.forest}></path>
<path d="M0 100q40-16 80 6t60 94H0z" fill={ink.forestDeep}></path>
<Pine x={30} y={92} height={40} fill={ink.forestDeep} />
<Pine x={58} y={84} height={34} fill={ink.grassDeep} />
<!-- Upper station -->
<rect x="64" y="36" width="34" height="18" fill={ink.wall}></rect>
<rect x="60" y="32" width="42" height="5" fill={ink.roof}></rect>
<!-- Cable, pylon and cabins -->
<path d="M84 40L320 176" fill="none" stroke={ink.dark} stroke-width="1.4"></path>
<rect x="176" y="92" width="4" height="52" fill={ink.marbleShade}></rect>
<rect x="168" y="88" width="20" height="5" fill={ink.marbleShade}></rect>
<g>
  <g>
    <rect x="128" y="64" width="1.6" height="10" fill={ink.dark}></rect>
    <rect x="118" y="74" width="22" height="18" rx="5" fill={ink.red}></rect>
    <rect x="121" y="78" width="16" height="7" rx="2" fill={ink.glass}></rect>
  </g>
  <g>
    <rect x="212" y="113" width="1.6" height="10" fill={ink.dark}></rect>
    <rect x="202" y="123" width="22" height="18" rx="5" fill={ink.yellow}></rect>
    <rect x="205" y="127" width="16" height="7" rx="2" fill={ink.glass}></rect>
  </g>
  <g>
    <rect x="276" y="150" width="1.6" height="10" fill={ink.dark}></rect>
    <rect x="266" y="160" width="22" height="18" rx="5" fill={ink.blue}></rect>
    <rect x="269" y="164" width="16" height="7" rx="2" fill={ink.glass}></rect>
  </g>
</g>
