---
import Scene from '@/components/scenes/Scene.astro';
import Icon from '@/components/ui/Icon.astro';
import type { Tour } from '@/domain/tour/Tour';
import { tr } from '@/i18n/tr';
import { formatMinutes } from '@/shared/format';

/**
 * Day-by-day programme drawn as a road with its stops, each with a picture of
 * the place. The page must include the pictures themselves with <SceneSprite>.
 */
interface Props {
  tour: Tour;
}

const { tour } = Astro.props;
---

<ol class="days">
  {tour.days.map((day) => (
    <li class="day">
      <div class="day__head">
        <p class="day__number">
          {day.number}. {tr.tour.day}
        </p>
        <h3>{day.title}</h3>
        <p class="day__summary">{day.summary}</p>
      </div>
      <ol class="stops">
        {day.stops.map((stop) => (
          <li class="stop" data-kind={stop.kind} data-reveal>
            <span class="stop__marker" aria-hidden="true">
              {stop.kind === 'lodging' && <Icon name="bed" size={16} />}
            </span>
            <div class="stop__body">
              <h4>{stop.name}</h4>
              <p>{stop.summary}</p>
            </div>
            <div class="stop__art">
              <Scene scene={stop.scene} />
            </div>
            {(stop.facts.length > 0 || stop.durationMinutes !== undefined) && (
              <div class="stop__more">
                {stop.facts.length > 0 && (
                  <dl class="stop__facts">
                    {stop.facts.map((fact) => (
                      <div>
                        <dt>{fact.label}</dt>
                        <dd>{fact.value}</dd>
                      </div>
                    ))}
                  </dl>
                )}
                {stop.durationMinutes !== undefined && (
                  <p class="stop__duration">
                    <Icon name="clock" size={16} />
                    {formatMinutes(stop.durationMinutes)}
                  </p>
                )}
              </div>
            )}
          </li>
        ))}
      </ol>
    </li>
  ))}
</ol>

<style>
  .days {
    display: grid;
    gap: var(--space-7);
  }

  .day {
    display: grid;
    gap: var(--space-5);
  }

  .day__number {
    display: inline-block;
    padding: 0.125rem var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--c-asphalt);
    color: var(--c-white);
    font-stretch: var(--wdth-sign);
    font-weight: 650;
    font-size: var(--text-small);
  }

  .day h3 {
    margin-top: var(--space-3);
  }

  .day__summary {
    margin-top: var(--space-2);
    color: var(--c-muted);
    max-width: 62ch;
  }

  .stops {
    --marker: 1.75rem;
    position: relative;
    display: grid;
    gap: var(--space-5);
  }

  /* The road the coach follows through the day. */
  .stops::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: calc(var(--marker) / 2 - 0.125rem);
    width: 0.25rem;
    border-radius: 0.125rem;
    background: var(--c-line);
    transform-origin: top;
  }

  /* The road is laid as the day scrolls into view. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .stops::before {
        /* Longhands on purpose: the minifier folds a timeline into the shorthand, which browsers reject. */
        animation-name: road-laid;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 5% cover 55%;
      }

      @keyframes road-laid {
        from {
          transform: scaleY(0);
        }
      }
    }
  }

  .stop {
    position: relative;
    display: grid;
    grid-template-columns: var(--marker) minmax(0, 1fr) 5.75rem;
    gap: var(--space-2) var(--space-4);
    /* Stops arrive as they are scrolled to, not in turn like a row of cards. */
    transition-delay: 0ms;
  }

  .stop__art {
    align-self: start;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-1);
    overflow: hidden;
  }

  /* What there is to know about the place; on a phone it runs under the picture too. */
  .stop__more {
    display: grid;
    gap: var(--space-2);
    grid-column: 2 / -1;
    color: var(--c-muted);
    font-size: var(--text-small);
  }

  .stop__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: 0;
  }

  .stop__facts div {
    display: flex;
    gap: var(--space-2);
  }

  .stop__facts dt {
    white-space: nowrap;
  }

  .stop__facts dd {
    margin: 0;
    color: var(--c-asphalt);
    font-weight: 650;
  }

  .stop__marker {
    display: grid;
    place-items: center;
    width: var(--marker);
    height: var(--marker);
    border: 0.25rem solid var(--c-white);
    border-radius: 50%;
    background: var(--c-brown);
    color: var(--c-white);
    box-shadow: 0 0 0 0.0625rem var(--c-line);
  }

  .stop[data-kind='departure'] .stop__marker,
  .stop[data-kind='arrival'] .stop__marker {
    background: var(--c-blue);
  }

  .stop[data-kind='rest'] .stop__marker {
    background: var(--c-white);
    box-shadow: inset 0 0 0 0.1875rem var(--c-muted);
  }

  .stop[data-kind='lodging'] .stop__marker {
    border-width: 0;
    background: var(--c-asphalt);
  }

  .stop__body h4 {
    font-size: 1.125rem;
    font-stretch: var(--wdth-sign);
    line-height: 1.3;
  }

  .stop__body p {
    margin-top: var(--space-1);
    color: var(--c-muted);
    max-width: 62ch;
  }

  .stop__duration {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  @media (min-width: 40rem) {
    .stop {
      grid-template-columns: var(--marker) minmax(0, 1fr) 9rem;
    }

    .stop__art {
      grid-row: span 2;
    }

    .stop__more {
      grid-column: 2;
    }
  }

  @media (min-width: 56rem) {
    .day {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--space-7);
    }

    .day__head {
      position: sticky;
      top: var(--space-5);
      align-self: start;
    }
  }
</style>
