---
import type { Occupancy } from '@/domain/tour/Occupancy';
import { occupancyText } from '@/shared/occupancyText';

interface Props {
  occupancy: Occupancy;
  /** Lets the demo panel update the figures on the same device. */
  departureId?: string;
}

const { occupancy, departureId } = Astro.props;
const text = occupancyText(occupancy);
---

<div
  class="meter"
  data-occupancy
  data-level={occupancy.level}
  data-departure-id={departureId}
  data-capacity={occupancy.capacity}
  data-booked={occupancy.booked}
>
  <div class="meter__labels">
    <span class="meter__percent tabular" data-occupancy-percent>
      {text.percent}
    </span>
    <span class="meter__status tabular" data-occupancy-status>
      {text.status}
    </span>
  </div>
  <svg class="meter__bar" viewBox="0 0 100 4" preserveAspectRatio="none" aria-hidden="true">
    <rect class="meter__track" width="100" height="4" rx="2"></rect>
    <rect
      class="meter__fill"
      data-occupancy-fill
      width={occupancy.percent}
      height="4"
      rx="2"
    ></rect>
  </svg>
</div>

<style>
  .meter {
    --level: var(--c-green);
    display: grid;
    gap: var(--space-2);
  }

  .meter[data-level='limited'] {
    --level: var(--c-yellow);
  }

  .meter[data-level='full'] {
    --level: var(--c-red);
  }

  /* The row keeps one height whether the status is plain text or a yellow tag, so meters line up. */
  .meter__labels {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 1.75rem;
    font-size: var(--text-small);
  }

  .meter__percent {
    color: var(--c-muted);
  }

  .meter__status {
    font-weight: 650;
  }

  .meter[data-level='limited'] .meter__status {
    padding: 0.125rem var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--c-yellow);
  }

  .meter[data-level='full'] .meter__status {
    color: var(--c-red);
  }

  .meter__bar {
    width: 100%;
    height: 0.375rem;
    overflow: visible;
  }

  .meter__track {
    fill: var(--c-line);
  }

  .meter__fill {
    fill: var(--level);
    transition:
      width var(--dur-panel) var(--ease-out),
      transform 900ms var(--ease-out) 300ms;
  }

  /* Inside something that arrives on scroll, the bar fills once it has arrived. */
  @media screen and (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    :global([data-reveal]:not([data-revealed])) .meter__fill {
      transform: scaleX(0);
      animation: fill-anyway 1ms 5s forwards;
    }

    @keyframes fill-anyway {
      to {
        transform: none;
      }
    }
  }
</style>

<script>
  import { syncOccupancy } from '@/features/occupancy-sync/syncOccupancy';
  import { LocalPassengerRepository } from '@/infrastructure/storage/LocalPassengerRepository';
  import { SafeStorage } from '@/infrastructure/storage/SafeStorage';

  syncOccupancy(document, new LocalPassengerRepository(new SafeStorage()));
</script>
