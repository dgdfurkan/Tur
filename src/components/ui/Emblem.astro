---
import type { EmblemKey } from '@/domain/tour/Tour';

/**
 * Destination pictograms in the manner of Turkish brown tourist signs:
 * solid, single-colour silhouettes that stay legible at sign size.
 */
interface Props {
  name: EmblemKey;
  size?: number;
}

const { name, size = 64 } = Astro.props;
---

<svg
  class="emblem"
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  {name === 'peribacasi' && (
    <g>
      <path d="M11 31 21 9l10 22Z" />
      <path d="M16 33h10l3 21H13Z" />
      <path d="M32 41l7-15 7 15Z" />
      <path d="M35.5 43h7l2 11h-11Z" />
      <path d="M42 14.5a8 8 0 0 1 16 0c0 5.2-4.6 8-6 11.5h-4c-1.4-3.5-6-6.3-6-11.5Z" />
      <rect x="47.5" y="27.5" width="5" height="3.5" rx="1" />
      <rect x="6" y="55" width="52" height="3" rx="1.5" />
    </g>
  )}
  {name === 'yayla' && (
    <g>
      <circle cx="50" cy="13" r="5" />
      <path d="M24 55 41 23l6 9 4-5 11 28Z" />
      <path d="M10 28l6-11 6 11h-3.5l5 9h-4l5.5 9H6l5.5-9h-4l5-9Z" />
      <rect x="14" y="46" width="4" height="9" />
      <rect x="4" y="55" width="58" height="3" rx="1.5" />
    </g>
  )}
  {name === 'antik-kent' && (
    <g>
      <path d="M8 23 32 8l24 15Z" />
      <rect x="9" y="25" width="46" height="4" />
      <rect x="13" y="31" width="7" height="20" rx="1" />
      <rect x="28.5" y="31" width="7" height="20" rx="1" />
      <rect x="44" y="31" width="7" height="20" rx="1" />
      <rect x="7" y="53" width="50" height="5" rx="1" />
    </g>
  )}
  {name === 'konak' && (
    <g fill-rule="evenodd">
      <path d="M5 27 32 9l27 18v3H5Z" />
      <path d="M10 31h44v13H10Zm5 3v7h7v-7Zm13.5 0v7h7v-7Zm13.5 0v7h7v-7Z" />
      <path d="M15 45h34v10H15Zm5 2.5v5h5v-5Zm9 0V55h6v-7.5Zm10 0v5h5v-5Z" />
      <rect x="6" y="55" width="52" height="3" rx="1.5" />
    </g>
  )}
  {name === 'vadi' && (
    <g>
      <path d="M5 40 21 13l10 17 7-9 21 19Z" />
      <rect x="4" y="43" width="56" height="15" rx="2" />
      <path class="cut" d="M36 42c-10 4 10 9-1 17" />
    </g>
  )}
</svg>

<style>
  .emblem {
    flex: none;
  }

  /* A river cut out of the ground; the gap shows the sign plate behind it. */
  .cut {
    fill: none;
    stroke: var(--emblem-cut, var(--c-brown));
    stroke-width: 4;
    stroke-linecap: round;
  }
</style>
