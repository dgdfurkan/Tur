---
import PanelShell from '@/components/panel/PanelShell.astro';
import SceneSprite from '@/components/scenes/SceneSprite.astro';
import { loadJourneySnapshots, loadTourSnapshots } from '@/composition/catalog';
import { SCENE_KEYS } from '@/domain/tour/Tour';
import { tr } from '@/i18n/tr';

// "<" is escaped so the JSON can never close its own script element.
const toursJson = JSON.stringify(await loadTourSnapshots()).replaceAll('<', '\\u003c');
const journeysJson = JSON.stringify(await loadJourneySnapshots()).replaceAll('<', '\\u003c');
---

<PanelShell
  title={tr.admin.title}
  description="Turların, kalkışların, yolcuların ve site içeriğinin yönetimi."
  current="app"
>
  <script is:inline type="application/json" data-tours set:html={toursJson} />
  <script is:inline type="application/json" data-journeys set:html={journeysJson} />
  <div class="screens" data-screen-host></div>
  <SceneSprite scenes={SCENE_KEYS} />
</PanelShell>

<script>
  import { whenPanelOpens } from '@/features/admin/access/gate';

  const root = document.querySelector<HTMLElement>('[data-admin]');
  // The app is fetched only once the panel has been opened; a visitor at the lock loads none of it.
  if (root) {
    void whenPanelOpens(root).then(async () => {
      const { mountAdmin } = await import('@/features/admin/bootstrap');
      mountAdmin(root);
    });
  }
</script>
