---
import ToursOverview from './ToursOverview.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { assetUrl, pageUrl } from '@/config/paths';
import type { Tour } from '@/domain/tour/Tour';
import { tr } from '@/i18n/tr';
import { formatDuration } from '@/shared/format';
import { routeSummary } from '@/shared/routeSummary';
import '@/styles/route-map.css';

/**
 * Every route on one map. The static SVG renders with the page; the 3D map
 * replaces it when the section scrolls into view. Choosing a tour swaps the
 * detail text with CSS alone and tells the 3D map to bring that road forward.
 */
interface Props {
  tours: readonly Tour[];
}

const { tours } = Astro.props;
---

<div class="tour-map" data-tour-map data-routes-url={assetUrl('veri/rotalar.json')}>
  <div class="tour-map__stage">
    <div class="tour-map__static">
      <ToursOverview tours={tours} />
    </div>
    <canvas class="tour-map__canvas" data-map-canvas aria-hidden="true"></canvas>
    <div class="tour-map__labels" data-map-labels aria-hidden="true"></div>
  </div>

  <fieldset class="tour-map__options">
    <legend class="visually-hidden">Haritada Öne Çıkarılacak Tur</legend>
    <label class="chip">
      <input class="visually-hidden" type="radio" name="tour-map" value="all" checked />
      <span>Tüm Rotalar</span>
    </label>
    {tours.map((tour) => (
      <label class="chip">
        <input class="visually-hidden" type="radio" name="tour-map" value={tour.id} />
        <span>{tour.destination}</span>
      </label>
    ))}
  </fieldset>

  <div class="tour-map__details">
    <div class="detail">
      <p class="detail__hint">Bir tur seçildiğinde rotası haritada öne çıkar.</p>
    </div>
    {tours.map((tour) => (
      <div class="detail">
        <p class="detail__duration">{formatDuration(tour.nights, tour.dayCount)}</p>
        <h3>{tour.title}</h3>
        <p>{routeSummary(tour)}</p>
        <div class="detail__actions">
          <Button href={pageUrl(`turlar/${tour.id}`)}>{tr.actions.viewTour}</Button>
          <Button href={pageUrl(`turlar/${tour.id}/rota`)} variant="secondary">
            <Icon slot="icon" name="route" />
            {tr.actions.previewRoute}
          </Button>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .tour-map {
    display: grid;
    gap: var(--space-5);
  }

  .tour-map__stage {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    background: #cfe4f2;
    overflow: hidden;
  }

  .tour-map__static,
  .tour-map__canvas,
  .tour-map__labels {
    position: absolute;
    inset: 0;
  }

  .tour-map__canvas {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 320ms ease;
  }

  .tour-map__labels {
    overflow: hidden;
    pointer-events: none;
  }

  .tour-map[data-ready='true'] .tour-map__canvas {
    opacity: 1;
  }

  .tour-map[data-ready='true'] .tour-map__static {
    visibility: hidden;
  }

  .tour-map__options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .chip span {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border: 0.09375rem solid var(--c-line);
    border-radius: var(--radius-md);
    background: var(--c-white);
    font-stretch: var(--wdth-sign);
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--dur-ui) ease,
      border-color var(--dur-ui) ease,
      transform var(--dur-press) var(--ease-out);
  }

  .chip span:active {
    transform: scale(0.97);
  }

  .chip input:checked + span {
    border-color: var(--c-brown);
    background: var(--c-brown);
    color: var(--c-white);
  }

  .chip input:focus-visible + span {
    outline: 3px solid var(--c-blue);
    outline-offset: 3px;
  }

  .detail {
    display: none;
    gap: var(--space-3);
  }

  /* The checked option and its detail block share a position in their lists. */
  .tour-map:has(.chip:nth-of-type(1) input:checked) .detail:nth-child(1),
  .tour-map:has(.chip:nth-of-type(2) input:checked) .detail:nth-child(2),
  .tour-map:has(.chip:nth-of-type(3) input:checked) .detail:nth-child(3),
  .tour-map:has(.chip:nth-of-type(4) input:checked) .detail:nth-child(4),
  .tour-map:has(.chip:nth-of-type(5) input:checked) .detail:nth-child(5),
  .tour-map:has(.chip:nth-of-type(6) input:checked) .detail:nth-child(6),
  .tour-map:has(.chip:nth-of-type(7) input:checked) .detail:nth-child(7),
  .tour-map:has(.chip:nth-of-type(8) input:checked) .detail:nth-child(8) {
    display: grid;
  }

  .detail p {
    color: var(--c-muted);
  }

  .detail .detail__duration {
    justify-self: start;
    padding: 0.0625rem var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--c-asphalt);
    color: var(--c-white);
    font-stretch: var(--wdth-sign);
    font-size: var(--text-caption);
    font-weight: 650;
  }

  .detail__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  @media (hover: hover) and (pointer: fine) {
    .chip input:not(:checked) + span:hover {
      border-color: var(--c-muted);
    }
  }

  @media (min-width: 40rem) {
    .tour-map__stage {
      aspect-ratio: 16 / 10;
    }
  }

  @media (min-width: 64rem) {
    .tour-map {
      grid-template-columns: minmax(0, 1fr) 20rem;
      grid-template-rows: auto 1fr;
      column-gap: var(--space-7);
    }

    .tour-map__stage {
      grid-row: 1 / -1;
    }

    .tour-map__details {
      align-self: start;
    }
  }
</style>

<script>
  import { mountTourMap } from '@/features/tour-map/bootstrap';

  const root = document.querySelector<HTMLElement>('[data-tour-map]');
  if (root) mountTourMap(root);
</script>
