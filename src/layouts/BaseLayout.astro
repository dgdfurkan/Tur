---
import { Font } from 'astro:assets';
import Announcement from '@/components/layout/Announcement.astro';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import { assetUrl } from '@/config/paths';
import { siteConfig } from '@/config/site';
import { tr } from '@/i18n/tr';
import '@/styles/base.css';

interface Props {
  title?: string;
  description?: string;
  /** Full-screen experiences (route simulation) render without header and footer. */
  chrome?: boolean;
}

const { title, description = siteConfig.brand.description, chrome = true } = Astro.props;
const pageTitle = title ? `${title} | ${siteConfig.brand.name}` : siteConfig.brand.name;
---

<!doctype html>
<html lang="tr" data-brand={siteConfig.brand.name}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {siteConfig.isPrototype && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#ffffff" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/svg+xml" href={assetUrl('favicon.svg')} />
    <Font cssVariable="--font-sans" preload />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#icerik">
      {tr.nav.skipToContent}
    </a>
    {chrome && <Announcement />}
    {chrome && <Header />}
    <main id="icerik">
      <slot />
    </main>
    {chrome && <Footer />}
  </body>
</html>

<script>
  import { applySiteSettings, readLocalSettings } from '@/features/site-sync/settings';
  import { SafeStorage } from '@/infrastructure/storage/SafeStorage';
  import { watchReveals } from '@/shared/reveal';
  import { enableTilt } from '@/shared/tilt';

  // On the office's device, the site shows what the panel has set there.
  const settings = readLocalSettings(new SafeStorage());
  if (settings) applySiteSettings(document, settings);
  watchReveals();
  enableTilt();
</script>
