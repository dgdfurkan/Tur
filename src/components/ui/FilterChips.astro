---
/**
 * A row of choices that filter a list without a script: each is a radio
 * button, and the page hides what the checked one leaves out with :has().
 */
interface Props {
  name: string;
  legend: string;
  options: readonly { value: string; label: string }[];
}

const { name, legend, options } = Astro.props;
---

<fieldset class="filter">
  <legend class="visually-hidden">{legend}</legend>
  {options.map((option, index) => (
    <label class="chip">
      <input
        class="visually-hidden"
        type="radio"
        name={name}
        value={option.value}
        checked={index === 0}
      />
      <span>{option.label}</span>
    </label>
  ))}
</fieldset>

<style>
  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-6);
    padding: 0;
    border: 0;
  }

  .chip span {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border: 0.09375rem solid var(--c-line);
    border-radius: var(--radius-md);
    background: var(--c-white);
    font-stretch: var(--wdth-sign);
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--dur-ui) ease,
      border-color var(--dur-ui) ease,
      transform var(--dur-press) var(--ease-out);
  }

  .chip span:active {
    transform: scale(0.97);
  }

  .chip input:checked + span {
    border-color: var(--c-blue);
    background: var(--c-blue);
    color: var(--c-white);
  }

  .chip input:focus-visible + span {
    outline: 3px solid var(--c-blue);
    outline-offset: 3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .chip input:not(:checked) + span:hover {
      border-color: var(--c-muted);
    }
  }
</style>
