---
/**
 * A road sign: coloured plate, white rim, rounded corners. Blue carries
 * information and navigation, brown marks tourist destinations.
 */
interface Props {
  tone?: 'blue' | 'brown';
  as?: 'div' | 'a' | 'li';
  href?: string;
  class?: string;
}

const { tone = 'blue', as: Tag = 'div', href, class: className } = Astro.props;
---

<Tag class:list={['sign', `sign--${tone}`, href && 'sign--link', className]} href={href}>
  <span class="sign__face">
    <slot />
  </span>
</Tag>

<style>
  .sign {
    --plate: var(--c-blue);
    --plate-pressed: var(--c-blue-deep);
    position: relative;
    display: block;
    padding: 0.3125rem;
    border-radius: var(--radius-sign);
    background: var(--plate);
    box-shadow: var(--shadow-sign);
    color: var(--c-white);
    text-decoration: none;
    overflow: hidden;
  }

  .sign--brown {
    --plate: var(--c-brown);
    --plate-pressed: var(--c-brown-deep);
  }

  .sign__face {
    display: block;
    height: 100%;
    border: 0.15625rem solid var(--c-white);
    border-radius: calc(var(--radius-sign) - 0.3125rem);
    font-stretch: var(--wdth-sign);
    font-weight: 600;
    letter-spacing: 0.005em;
  }

  /* Retroreflective sheeting catches the light when something passes by. */
  .sign--link::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 35%,
      rgb(255 255 255 / 0.22) 50%,
      transparent 65%
    );
    transform: translateX(-100%);
    pointer-events: none;
  }

  .sign--link {
    transition:
      transform var(--dur-press) var(--ease-out),
      background-color var(--dur-ui) ease;
  }

  .sign--link:active {
    transform: scale(0.985);
    background: var(--plate-pressed);
  }

  @media (hover: hover) and (pointer: fine) {
    .sign--link:hover::after {
      transform: translateX(100%);
      transition: transform 700ms var(--ease-out);
    }
  }
</style>
