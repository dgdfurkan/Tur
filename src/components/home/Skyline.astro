---
/**
 * A line drawing of the places the tours reach, standing on the ground of the
 * section below: fairy chimneys and a balloon, a citadel, a snow-capped
 * mountain, pines and temple columns. Purely decorative.
 */
---

<svg
  class="skyline"
  viewBox="0 0 1440 170"
  preserveAspectRatio="xMidYMax slice"
  aria-hidden="true"
  focusable="false"
>
  <path
    class="skyline__far"
    d="M0 170V128c70-22 150-26 230-8 60 14 110 16 170 4 90-18 170-12 250 10 70 18 130 14 200-6 120-34 240-30 350 4 80 24 160 22 240 2v36Z"
  ></path>
  <g class="skyline__near">
    <path d="M0 170v-22c50-14 110-16 170-6 40 6 70 8 96 8V170Z"></path>
    <path d="M286 170l6-34h16l6 34Z"></path>
    <path d="M288 136l12-24 12 24Z"></path>
    <path d="M326 170l5-26h13l5 26Z"></path>
    <path d="M328 144l9.5-19 9.5 19Z"></path>
    <path d="M362 170l7-44h18l7 44Z"></path>
    <path d="M365 126l13-27 13 27Z"></path>
    <path d="M432 62a17 17 0 0 1 34 0c0 11-9 17-12 25h-10c-3-8-12-14-12-25Z"></path>
    <path d="M444 91h10v7h-10Z"></path>
    <path d="M520 170v-38h12v-9h10v9h14v-9h10v9h14v-9h10v9h12v38Z"></path>
    <path d="M640 170 760 58l34 40 26-22 96 94Z"></path>
    <path class="skyline__snow" d="M760 58l-30 28 14 -4 12 12 12-10 14 8 12-8-34-26Z"></path>
    <path d="M948 170v-14h-14l14-22h-9l15-26 15 26h-9l14 22h-14v14Z"></path>
    <path d="M998 170v-12h-12l12-19h-8l13-22 13 22h-8l12 19h-12v12Z"></path>
    <path d="M1090 170v-8h10v-44h-8v-7l52-24 52 24v7h-8v44h10v8Z"></path>
    <path class="skyline__gap" d="M1114 162v-44h14v44ZM1160 162v-44h14v44Z"></path>
    <path d="M1240 170v-16c60-16 130-18 200-4V170Z"></path>
  </g>
</svg>

<style>
  .skyline {
    display: block;
    width: 100%;
    height: clamp(5rem, 11vw, 10.5rem);
  }

  .skyline path {
    stroke: var(--c-line);
    stroke-width: 1.5;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .skyline__far {
    fill: #f8fafb;
  }

  /* Filled with the next section's colour, so the shapes rise out of its ground. */
  .skyline__near path {
    fill: var(--c-mist);
  }

  .skyline__near .skyline__snow,
  .skyline__near .skyline__gap {
    fill: var(--c-white);
  }
</style>
