---
interface Props {
  title: string;
  lead?: string;
  id?: string;
}

const { title, lead, id } = Astro.props;
---

<div class="section-heading">
  <h2 id={id}>{title}</h2>
  {lead && <p class="lead">{lead}</p>}
</div>

<style>
  .section-heading {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }
</style>
