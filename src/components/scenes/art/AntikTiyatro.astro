---
import { ink } from '../palette';
import Cloud from '../parts/Cloud.astro';
---

<rect width="320" height="200" fill={ink.skyDay}></rect>
<Cloud x={250} y={26} scale={1} />
<path d="M0 60q80-20 170-10t150-16v50H0z" fill={ink.farSand}></path>
<!-- Seating rising in a half circle -->
<path d="M-10 200V86q170-64 340 0v114z" fill={ink.stoneShade}></path>
<g fill="none" stroke={ink.marble} stroke-width="9">
  <path d="M6 200v-98q154-54 308 0v98"></path>
  <path d="M34 200v-84q126-44 252 0v84"></path>
  <path d="M62 200v-70q98-34 196 0v70"></path>
  <path d="M90 200v-56q70-24 140 0v56"></path>
</g>
<!-- Stairways between the wedges -->
<g stroke={ink.stoneDeep} stroke-width="2.5">
  <path d="M160 58v86M76 78l30 68M244 78l-30 68"></path>
</g>
<!-- Orchestra -->
<path d="M112 200v-40q48-16 96 0v40z" fill={ink.sand}></path>
<!-- Stage building -->
<rect x="96" y="172" width="128" height="28" fill={ink.marble}></rect>
<rect x="96" y="172" width="128" height="4" fill={ink.marbleShade}></rect>
<g fill={ink.marbleShade}>
  <rect x="104" y="178" width="5" height="22"></rect>
  <rect x="122" y="178" width="5" height="22"></rect>
  <rect x="140" y="178" width="5" height="22"></rect>
  <rect x="175" y="178" width="5" height="22"></rect>
  <rect x="193" y="178" width="5" height="22"></rect>
  <rect x="211" y="178" width="5" height="22"></rect>
</g>
<path d="M152 200v-16q8-8 16 0v16z" fill={ink.dark}></path>
