{
  "name": "tur",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ankara çıkışlı turlar için tanıtım sitesi, 3D rota simülasyonu ve demo operasyon paneli",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "map:build": "node scripts/build-map-data.ts",
    "verify": "npm run check && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/encode-sans": "^5.3.0",
    "astro": "^7.3.5",
    "gsap": "^3.15.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "topojson-client": "^3.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2",
    "world-atlas": "^2.0.2"
  }
}
