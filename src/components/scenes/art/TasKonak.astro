  <rect x="44" y="176" width="30" height="8" rx="3"></rect>
  <rect x="84" y="176" width="24" height="8" rx="3"></rect>
  <rect x="118" y="176" width="32" height="8" rx="3"></rect>
  <rect x="160" y="176" width="26" height="8" rx="3"></rect>
  <rect x="196" y="176" width="30" height="8" rx="3"></rect>
  <rect x="236" y="176" width="26" height="8" rx="3"></rect>
  <rect x="272" y="176" width="34" height="8" rx="3"></rect>
  <rect x="24" y="188" width="30" height="8" rx="3"></rect>
