---
import PageHead from '@/components/layout/PageHead.astro';
import JourneyStub from '@/components/journey/JourneyStub.astro';
import JourneySync from '@/components/journey/JourneySync.astro';
import SceneSprite from '@/components/scenes/SceneSprite.astro';
import Button from '@/components/ui/Button.astro';
import Steps from '@/components/ui/Steps.astro';
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import { journeyArchive } from '@/composition/catalog';
import { pageUrl } from '@/config/paths';
import { tr } from '@/i18n/tr';
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Feature {
  icon: IconName;
  title: string;
  text: string;
}

const school: Feature[] = [
  {
    icon: 'list',
    title: 'Müfredatla Uyumlu Program',
    text: 'Gezi programı, sınıf düzeyine ve dersin kazanımlarına göre öğretmenlerle birlikte hazırlanır.',
  },
  {
    icon: 'bus',
    title: 'Belgeli Araç ve Sürücü',
    text: 'Araç ve sürücü belgeleri, gezi öncesinde okul idaresine yazılı olarak sunulur.',
  },
  {
    icon: 'shield',
    title: 'Sigorta',
    text: 'Her öğrenci ve öğretmen, zorunlu paket tur sigortası kapsamına alınır.',
  },
  {
    icon: 'mail',
    title: 'Veli Bilgilendirmesi',
    text: 'Program ile kalkış ve dönüş saatleri velilere yazılı olarak iletilir.',
  },
];

const institutions: Feature[] = [
  {
    icon: 'users',
    title: 'Kurum İçi Geziler',
    text: 'Personel gezileri ve hizmet içi eğitim programları için günübirlik veya konaklamalı turlar düzenlenir.',
  },
  {
    icon: 'seat',
    title: 'Toplu Katılım',
    text: 'Grubun büyüklüğüne göre araç, otel ve rehber kapasitesi önceden ayrılır.',
  },
  {
    icon: 'receipt',
    title: 'Resmî Belgelendirme',
    text: 'Teklif, sözleşme ve fatura süreçleri kurumun mevzuatına uygun biçimde yürütülür.',
  },
];

const groupJourneys = (await journeyArchive.ofGroups(['okul', 'kurum'])).slice(0, 3);

const steps = [
  {
    title: 'İhtiyacın Bildirilmesi',
    text: 'Katılımcı sayısı, tarih aralığı ve gidilmek istenen bölge ofisimize iletilir.',
  },
  {
    title: 'Program ve Teklif',
    text: 'Üç iş günü içinde günlük program ve kişi başı fiyat yazılı olarak sunulur.',
  },
  {
    title: 'Onay ve Hazırlık',
    text: 'Onayın ardından araç, konaklama ve rehber ayrılır; katılımcı listesi sigorta için alınır.',
  },
];
---

<BaseLayout
  title="Kurumsal ve Okul Turları"
  description="Okullar, kamu kurumları ve şirketler için tarih, program ve bütçeye göre düzenlenen özel turlar."
>
  <PageHead
    title="Kurumsal ve Okul Turları"
    lead="Okullar, kamu kurumları ve şirketler için tarih, program ve bütçeye göre özel turlar düzenlenir."
  />

  <section class="section container" aria-labelledby="okul-gezileri">
    <h2 id="okul-gezileri">Okul Gezileri</h2>
    <ul class="features">
      {school.map((feature) => (
        <li class="feature" data-reveal>
          <Icon name={feature.icon} size={28} />
          <div>
            <h3>{feature.title}</h3>
            <p>{feature.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="section section--mist" aria-labelledby="kurumlar">
    <div class="container">
      <h2 id="kurumlar">Kamu Kurumları ve Şirketler</h2>
      <ul class="features">
        {institutions.map((feature) => (
          <li class="feature" data-reveal>
            <Icon name={feature.icon} size={28} />
            <div>
              <h3>{feature.title}</h3>
              <p>{feature.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {groupJourneys.length > 0 && (
    <section class="section container" aria-labelledby="gezilerimiz">
      <h2 id="gezilerimiz">{tr.journeys.fromGroups}</h2>
      <p class="lead section-lead">{tr.journeys.fromGroupsLead}</p>
      <ul class="stubs">
        {groupJourneys.map((journey) => (
          <li data-reveal data-journey-card={journey.id}>
            <JourneyStub journey={journey} />
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="section section--mist" aria-labelledby="teklif-sureci">
    <div class="container">
      <h2 id="teklif-sureci">Teklif Süreci</h2>
      <div class="steps-wrap">
        <Steps steps={steps} />
      </div>
      <div class="cta">
        <Button href={pageUrl('iletisim')} size="lg">
          Teklif İçin İletişime Geçin
        </Button>
      </div>
    </div>
  </section>
  <SceneSprite scenes={groupJourneys.map((journey) => journey.scene)} />
  <JourneySync />
</BaseLayout>

<style>
  .features {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .steps-wrap {
    margin-top: var(--space-6);
  }

  .feature {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: start;
  }

  .feature :global(svg) {
    margin-top: 0.125rem;
    color: var(--c-blue);
  }

  .feature h3 {
    font-size: 1.25rem;
  }

  .feature p {
    margin-top: var(--space-2);
    color: var(--c-muted);
    max-width: 52ch;
  }

  .cta {
    margin-top: var(--space-7);
  }

  .section-lead {
    margin: var(--space-4) 0 var(--space-7);
  }

  .stubs {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 40rem) {
    .stubs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 68rem) {
    .stubs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 48rem) {
    .features {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
