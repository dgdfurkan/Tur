---
import PageHead from '@/components/layout/PageHead.astro';
import SceneSprite from '@/components/scenes/SceneSprite.astro';
import TourTicket from '@/components/tour/TourTicket.astro';
import { tourCatalog } from '@/composition/catalog';
import { tr } from '@/i18n/tr';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { todayIso } from '@/shared/format';

const today = todayIso();
const tours = await tourCatalog.listTours();

const filters = [
  { value: 'all', label: tr.categories.all },
  { value: 'kultur', label: tr.categories.kultur },
  { value: 'doga', label: tr.categories.doga },
  { value: 'gunubirlik', label: tr.categories.gunubirlik },
];
---

<BaseLayout
  title={tr.nav.tours}
  description="Ankara çıkışlı tüm turlar: kalkış tarihleri, fiyatlar ve güncel doluluk durumu."
>
  <PageHead
    title={tr.nav.tours}
    lead="Ankara çıkışlı tüm programlar, en yakın kalkış tarihi ve güncel doluluk durumuyla listelenir."
  />

  <section class="container tours" aria-label="Tur Listesi">
    <fieldset class="filter">
      <legend class="visually-hidden">Tur Türü</legend>
      {filters.map((filter, index) => (
        <label class="chip">
          <input
            class="visually-hidden"
            type="radio"
            name="category"
            value={filter.value}
            checked={index === 0}
          />
          <span>{filter.label}</span>
        </label>
      ))}
    </fieldset>

    <ul class="ticket-list">
      {tours.map((tour) => (
        <li data-category={tour.category} data-reveal data-tour-card={tour.id}>
          <TourTicket tour={tour} departure={tour.nextDeparture(today)} headingLevel="h2" />
        </li>
      ))}
    </ul>
  </section>
  <SceneSprite scenes={tours.map((tour) => tour.scene)} />
</BaseLayout>

<style>
  .tours {
    padding-block: var(--space-6) var(--space-section);
  }

  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-6);
    padding: 0;
    border: 0;
  }

  .chip span {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border: 0.09375rem solid var(--c-line);
    border-radius: var(--radius-md);
    font-stretch: var(--wdth-sign);
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--dur-ui) ease,
      border-color var(--dur-ui) ease,
      transform var(--dur-press) var(--ease-out);
  }

  .chip span:active {
    transform: scale(0.97);
  }

  .chip input:checked + span {
    border-color: var(--c-blue);
    background: var(--c-blue);
    color: var(--c-white);
  }

  .chip input:focus-visible + span {
    outline: 3px solid var(--c-blue);
    outline-offset: 3px;
  }

  .ticket-list {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 40rem) {
    .ticket-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 68rem) {
    .ticket-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Filtering needs no script: the checked radio decides which tickets show. */
  .tours:has(input[value='kultur']:checked) li:not([data-category='kultur']),
  .tours:has(input[value='doga']:checked) li:not([data-category='doga']),
  .tours:has(input[value='gunubirlik']:checked) li:not([data-category='gunubirlik']) {
    display: none;
  }

  /*
   * A ticket the filter brings back arrives rather than appears: the animation
   * starts again each time the ticket is shown. It ends at whatever the ticket's
   * own state is, so it never shows a ticket that has yet to be revealed.
   */
  @media (prefers-reduced-motion: no-preference) {
    .ticket-list li {
      animation: ticket-arrives 420ms var(--ease-out) backwards;
    }

    .ticket-list li:nth-child(2) {
      animation-delay: 60ms;
    }

    .ticket-list li:nth-child(3) {
      animation-delay: 120ms;
    }

    .ticket-list li:nth-child(n + 4) {
      animation-delay: 180ms;
    }

    @keyframes ticket-arrives {
      from {
        opacity: 0;
        transform: translateY(0.75rem);
      }
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .chip input:not(:checked) + span:hover {
      border-color: var(--c-muted);
    }
  }
</style>
