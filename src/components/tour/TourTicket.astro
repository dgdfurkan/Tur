---
import OccupancyMeter from './OccupancyMeter.astro';
import Emblem from '@/components/ui/Emblem.astro';
import { pageUrl } from '@/config/paths';
import type { Departure } from '@/domain/tour/Departure';
import type { Tour } from '@/domain/tour/Tour';
import { categoryLabels, tr } from '@/i18n/tr';
import { formatDateRange, formatDuration, formatMoney, formatTime } from '@/shared/format';

/** A tour presented as a boarding pass: journey on the left, fare stub on the right. */
interface Props {
  tour: Tour;
  departure?: Departure | undefined;
  headingLevel?: 'h2' | 'h3';
}

const { tour, departure, headingLevel: Heading = 'h3' } = Astro.props;
const tourUrl = pageUrl(`turlar/${tour.id}`);
---

<article class="ticket" data-category={tour.category}>
  <div class="ticket__main">
    <div class="ticket__emblem">
      <Emblem name={tour.emblem} size={56} />
    </div>
    <div class="ticket__body">
      <p class="ticket__category">{categoryLabels[tour.category]}</p>
      <Heading class="ticket__title">
        <a href={tourUrl}>{tour.title}</a>
      </Heading>
      <dl class="ticket__facts">
        <div class="ticket__fact--wide">
          <dt>{tr.tour.nextDeparture}</dt>
          <dd>
            {departure
              ? formatDateRange(departure.startDate, departure.endDate)
              : tr.tour.noDepartures}
          </dd>
        </div>
        <div>
          <dt>{tr.tour.duration}</dt>
          <dd>{formatDuration(tour.nights, tour.dayCount)}</dd>
        </div>
        {departure && (
          <div>
            <dt>{tr.tour.departureTime}</dt>
            <dd class="tabular">{formatTime(departure.time)}</dd>
          </div>
        )}
      </dl>
    </div>
  </div>

  <div class="ticket__stub">
    <p class="ticket__price">
      <span class="ticket__price-label">{tr.tour.perPerson}</span>
      <strong class="tabular">{formatMoney(tour.price)}</strong>
    </p>
    {departure && <OccupancyMeter occupancy={departure.occupancy} departureId={departure.id} />}
  </div>
</article>

<style>
  .ticket {
    --cut: var(--section-bg, var(--c-white));
    --notch: 0.75rem;
    position: relative;
    display: grid;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    background: var(--c-white);
    box-shadow: var(--shadow-1);
    transition:
      transform var(--dur-ui) var(--ease-out),
      box-shadow var(--dur-ui) ease;
  }

  .ticket__main {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    padding: var(--space-5);
  }

  .ticket__emblem {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: var(--radius-md);
    background: var(--c-brown);
    box-shadow:
      inset 0 0 0 0.1875rem var(--c-brown),
      inset 0 0 0 0.3125rem var(--c-white);
    color: var(--c-white);
  }

  .ticket__category {
    color: var(--c-brown);
    font-size: var(--text-small);
    font-weight: 650;
  }

  .ticket__title {
    margin-top: var(--space-1);
    font-size: var(--text-h3);
  }

  /* The whole ticket is one target; the link stretches over it. */
  .ticket__title a {
    text-decoration: none;
  }

  .ticket__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }

  .ticket__facts {
    display: grid;
    grid-template-columns: repeat(2, auto);
    justify-content: start;
    gap: var(--space-3) var(--space-6);
    margin: var(--space-4) 0 0;
  }

  .ticket__fact--wide {
    grid-column: 1 / -1;
  }

  .ticket__facts dt,
  .ticket__price-label {
    display: block;
    color: var(--c-muted);
    font-size: var(--text-caption);
  }

  .ticket__facts dd {
    margin: 0;
    font-weight: 600;
  }

  .ticket__stub {
    position: relative;
    display: grid;
    gap: var(--space-4);
    align-content: center;
    padding: var(--space-5);
    border-top: 0.125rem dashed var(--c-line);
  }

  /* Punched notches where the stub tears off. */
  .ticket__stub::before,
  .ticket__stub::after {
    content: '';
    position: absolute;
    top: calc(var(--notch) * -1 - 1px);
    width: calc(var(--notch) * 2);
    height: calc(var(--notch) * 2);
    border: 1px solid var(--c-line);
    border-radius: 50%;
    background: var(--cut);
  }

  .ticket__stub::before {
    left: calc(var(--notch) * -1 - 1px);
    clip-path: inset(0 0 0 50%);
  }

  .ticket__stub::after {
    right: calc(var(--notch) * -1 - 1px);
    clip-path: inset(0 50% 0 0);
  }

  .ticket__price strong {
    display: block;
    font-stretch: var(--wdth-heading);
    font-size: 1.75rem;
    font-weight: 750;
    line-height: 1.1;
  }

  .ticket:has(a:active) {
    transform: scale(0.99);
  }

  .ticket:has(a:focus-visible) {
    outline: 3px solid var(--c-blue);
    outline-offset: 3px;
  }

  .ticket__title a:focus-visible {
    outline: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .ticket:hover {
      transform: translateY(-0.1875rem);
      box-shadow: var(--shadow-2);
    }
  }

  @media (min-width: 48rem) {
    .ticket {
      grid-template-columns: 1fr minmax(15rem, 18rem);
    }

    .ticket__main {
      padding: var(--space-6);
    }

    .ticket__facts {
      grid-template-columns: repeat(3, auto);
    }

    .ticket__fact--wide {
      grid-column: auto;
    }

    .ticket__stub {
      padding: var(--space-6);
      border-top: 0;
      border-left: 0.125rem dashed var(--c-line);
    }

    .ticket__stub::before,
    .ticket__stub::after {
      left: calc(var(--notch) * -1 - 1px);
      right: auto;
    }

    .ticket__stub::before {
      top: calc(var(--notch) * -1 - 1px);
      clip-path: inset(50% 0 0 0);
    }

    .ticket__stub::after {
      top: auto;
      bottom: calc(var(--notch) * -1 - 1px);
      clip-path: inset(0 0 50% 0);
    }
  }
</style>
