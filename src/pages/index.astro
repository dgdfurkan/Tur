---
import FaqList from '@/components/faq/FaqList.astro';
import DistanceSign from '@/components/home/DistanceSign.astro';
import JourneyStub from '@/components/journey/JourneyStub.astro';
import JourneySync from '@/components/journey/JourneySync.astro';
import Odometer from '@/components/journey/Odometer.astro';
import RoadScene from '@/components/home/RoadScene.astro';
import SceneSprite from '@/components/scenes/SceneSprite.astro';
import ServiceSign from '@/components/home/ServiceSign.astro';
import TourMap from '@/components/home/TourMap.astro';
import TourTicket from '@/components/tour/TourTicket.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Steps from '@/components/ui/Steps.astro';
import { journeyArchive, loadFaq, tourCatalog } from '@/composition/catalog';
import { pageUrl } from '@/config/paths';
import { siteConfig } from '@/config/site';
import { totalsOf } from '@/domain/journey/Journey';
import { tr } from '@/i18n/tr';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, formatKm, formatNumber, formatTime, todayIso } from '@/shared/format';
import { occupancyText } from '@/shared/occupancyText';

const today = todayIso();
const tours = await tourCatalog.listTours();

const upcoming = await tourCatalog.nextDepartures(today, 4);
const [soonest] = await tourCatalog.upcomingDepartures(today, 1);
const journeys = await journeyArchive.list();
const journeyTotals = totalsOf(journeys);
const latestJourneys = journeys.slice(0, 3);
const questions = (await loadFaq()).filter((question) => question.featured);

const services = [
  {
    icon: 'shield',
    title: 'Zorunlu Paket Tur Sigortası',
    text: 'Her misafir, tur başlamadan önce sigorta kapsamına alınır.',
  },
  {
    icon: 'guide',
    title: 'Profesyonel Rehber',
    text: 'Turlara Kültür ve Turizm Bakanlığı ruhsatlı rehberler eşlik eder.',
  },
  {
    icon: 'bus',
    title: 'Konforlu Araç',
    text: 'Konaklamalı turlarda 2+1 koltuk düzenli, klimalı otobüsler kullanılır.',
  },
  {
    icon: 'receipt',
    title: 'Açık Fiyat',
    text: 'Fiyata dâhil olan ve olmayan hizmetler her tur sayfasında ayrı ayrı yazılır.',
  },
] as const;
---

<BaseLayout>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <h1 data-site-text="heroTitle">{siteConfig.home.title}</h1>
        <p class="lead" data-site-text="heroLead">
          {siteConfig.home.lead}
        </p>
      </div>
      <div class="hero__actions">
        <Button href={pageUrl('turlar')} size="lg">
          {tr.actions.browseTours}
        </Button>
        <Button href={pageUrl('turlar/kapadokya/rota')} variant="secondary" size="lg">
          <Icon slot="icon" name="route" />
          Kapadokya Rotasını Ön İzle
        </Button>
        {
          soonest && (
            <a
              class="next-board"
              href={`${pageUrl(`turlar/${soonest.tour.id}`)}#kalkis-tarihleri`}
              data-tour-card={soonest.tour.id}
            >
              <span class="next-board__label">{tr.nextBoard.label}</span>
              <span class="next-board__line">
                {tr.nextBoard.line(
                  formatDate(soonest.departure.startDate),
                  formatTime(soonest.departure.time),
                  soonest.tour.title,
                )}
              </span>
              <span class="next-board__seats" data-level={soonest.departure.occupancy.level}>
                {occupancyText(soonest.departure.occupancy).status}
              </span>
            </a>
          )
        }
      </div>
      <div class="hero__sign">
        <DistanceSign tours={tours} />
        <p class="hero__caption">Mesafeler Ankara'dan itibaren kilometre cinsindendir.</p>
      </div>
    </div>
    <RoadScene />
  </section>

  <section class="section section--mist" aria-labelledby="yaklasan-turlar">
    <div class="container">
      <SectionHeading
        id="yaklasan-turlar"
        title="Yaklaşan Turlar"
        lead="Kalkış tarihi en yakın olan turlar, güncel doluluk durumuyla listelenir."
      />
      <ul class="ticket-list">
        {upcoming.map(({ tour, departure }) => (
          <li data-reveal data-tour-card={tour.id}>
            <TourTicket tour={tour} departure={departure} />
          </li>
        ))}
      </ul>
      <div class="section__more">
        <Button href={pageUrl('turlar')} variant="secondary">
          {tr.actions.allTours}
        </Button>
        <Button href={pageUrl('takvim')} variant="secondary">
          {tr.actions.calendar}
        </Button>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="tur-haritasi">
    <div class="container">
      <SectionHeading
        id="tur-haritasi"
        title="Tur Haritası"
        lead="Tüm rotalar tek haritada gösterilir; otobüsler güzergâhlarını izler."
      />
      <TourMap tours={tours} />
    </div>
  </section>

  <section class="section section--mist" aria-labelledby="rezervasyon">
    <div class="container">
      <SectionHeading id="rezervasyon" title={tr.booking.title} lead={tr.booking.lead} />
      <Steps steps={tr.booking.steps} />
    </div>
  </section>

  {latestJourneys.length > 0 && (
    <section class="section" aria-labelledby="gecmis-turlar">
      <div class="container">
        <div class="journeys__intro">
          <SectionHeading
            id="gecmis-turlar"
            title={tr.journeys.teaser}
            lead={tr.journeys.teaserLead}
          />
          <Odometer km={journeyTotals.distanceKm}>
            {tr.journeys.totals(
              formatNumber(journeyTotals.count),
              formatNumber(journeyTotals.guests),
              formatKm(journeyTotals.distanceKm),
            )}
          </Odometer>
        </div>
        <ul class="ticket-list ticket-list--three">
          {latestJourneys.map((journey) => (
            <li data-reveal data-journey-card={journey.id}>
              <JourneyStub journey={journey} />
            </li>
          ))}
        </ul>
        <div class="section__more">
          <Button href={pageUrl('gecmis-turlar')} variant="secondary">
            {tr.actions.pastTours}
          </Button>
        </div>
      </div>
    </section>
  )}

  <section class="section section--mist" aria-labelledby="hizmetler">
    <div class="container">
      <SectionHeading id="hizmetler" title="Her Turda Standart Olan Hizmetler" />
      <ul class="services">
        {services.map((service) => (
          <ServiceSign {...service} />
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="sorular">
    <div class="container">
      <div class="questions">
        <div class="questions__head">
          <SectionHeading id="sorular" title={tr.faq.title} lead={tr.faq.lead} />
          <Button href={pageUrl('sss')} variant="secondary">
            {tr.actions.allQuestions}
          </Button>
        </div>
        <FaqList items={questions} name="ana-sayfa-sss" />
      </div>
    </div>
  </section>

  <section class="corporate" aria-labelledby="kurumsal">
    <div class="container">
      <div class="corporate__sign" data-reveal>
        <div>
          <h2 id="kurumsal">Kurumsal ve Okul Turları</h2>
          <p class="lead">
            Okullar, kamu kurumları ve şirketler için tarih, program ve bütçeye göre özel turlar
            düzenlenir.
          </p>
        </div>
        <Button href={pageUrl('kurumsal')} size="lg">
          Kurumsal Turları İncele
        </Button>
      </div>
    </div>
  </section>
  <SceneSprite
    scenes={[...tours.map((tour) => tour.scene), ...latestJourneys.map((journey) => journey.scene)]}
  />
  <JourneySync />
</BaseLayout>

<style>
  .hero {
    /* Tall enough to show the whole landscape with its sky: the stage is 1440 by 420. */
    --scene-height: max(clamp(11.5rem, 26vw, 25rem), calc(100vw * 420 / 1440));
    /* The ground the sign's posts stand on is this far above the hero's bottom edge. */
    --ground: calc(var(--scene-height) * 0.171);
    position: relative;
    padding-top: clamp(2rem, 1rem + 5vw, 5rem);
    /* Sky: clear overhead, warm towards the horizon. */
    background: linear-gradient(180deg, #fff 0%, #eef6fb 16%, #d3e8f6 60%, #f6e8d1 100%);
    overflow: hidden;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-areas: 'copy' 'actions' 'sign';
    gap: var(--space-6);
    align-items: center;
    padding-bottom: var(--ground);
  }

  .hero__copy {
    grid-area: copy;
  }

  .hero h1 {
    font-size: var(--text-display);
    font-stretch: var(--wdth-display);
    font-weight: 780;
    line-height: 0.98;
    letter-spacing: -0.02em;
  }

  .hero .lead {
    margin-top: var(--space-5);
  }

  .hero__actions {
    grid-area: actions;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* The departure board of a coach terminal: the next coach out, in amber on black. */
  .next-board {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.125rem var(--space-4);
    align-items: center;
    width: 100%;
    max-width: 34rem;
    margin-top: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--c-asphalt);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.08),
      var(--shadow-1);
    color: #ffc93d;
    text-decoration: none;
    transition: transform var(--dur-press) var(--ease-out);
  }

  .next-board__label {
    grid-column: 1 / -1;
    color: rgb(255 255 255 / 0.7);
    font-size: var(--text-caption);
    font-weight: 600;
  }

  .next-board__line {
    font-stretch: var(--wdth-sign);
    font-weight: 650;
    line-height: 1.3;
  }

  .next-board__seats {
    padding: 0.125rem var(--space-2);
    border-radius: var(--radius-sm);
    background: rgb(255 255 255 / 0.1);
    color: var(--c-white);
    font-size: var(--text-small);
    font-weight: 650;
    white-space: nowrap;
  }

  .next-board__seats[data-level='limited'] {
    background: var(--c-yellow);
    color: var(--c-asphalt);
  }

  .next-board__seats[data-level='full'] {
    background: var(--c-red);
  }

  .next-board:active {
    transform: scale(0.99);
  }

  .next-board:focus-visible {
    outline-offset: 3px;
  }

  /* As wide as the board, so the plate under it can be centred between the posts. */
  .hero__sign {
    --post-height: 5.75rem;
    position: relative;
    grid-area: sign;
    justify-self: center;
    width: min(100%, 32rem);
  }

  /* A small plate under the board, as on the road. */
  .hero__caption {
    position: absolute;
    top: calc(100% - var(--post-height) + var(--space-3));
    left: 50%;
    width: max-content;
    max-width: 58%;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    background: rgb(255 255 255 / 0.92);
    box-shadow: var(--shadow-1);
    color: var(--c-asphalt);
    font-size: var(--text-caption);
    line-height: 1.35;
    text-align: center;
    transform: translateX(-50%);
  }

  .section--mist {
    --section-bg: var(--c-mist);
  }

  .ticket-list {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 40rem) {
    .ticket-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 76rem) {
    .ticket-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 60rem) {
    .ticket-list--three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .journeys__intro {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-8);
    }
  }

  @media (min-width: 76rem) {
    .ticket-list--three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .section__more {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .journeys__intro {
    display: grid;
    gap: var(--space-5);
    align-items: end;
    margin-bottom: var(--space-7);
  }

  .journeys__intro :global(.section-heading) {
    margin-bottom: 0;
  }

  .questions {
    display: grid;
    gap: var(--space-2);
    max-width: 56rem;
  }

  .questions__head {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    margin-bottom: var(--space-5);
  }

  .questions__head :global(.section-heading) {
    margin-bottom: 0;
  }

  .services {
    display: grid;
    gap: var(--space-6);
  }

  /* The last thing before the road: a blue direction sign as wide as the page. */
  .corporate {
    padding-block: var(--space-7) var(--space-8);
    background: var(--c-blue);
    color: var(--c-white);
  }

  .corporate__sign {
    display: grid;
    gap: var(--space-6);
    align-items: center;
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    border: 0.1875rem solid var(--c-white);
    border-radius: var(--radius-lg);
  }

  .corporate .lead {
    margin-top: var(--space-4);
    color: rgb(255 255 255 / 0.86);
  }

  .corporate :global(.button--primary) {
    background: var(--c-white);
    color: var(--c-blue-deep);
  }

  .corporate :global(:focus-visible) {
    outline-color: var(--c-white);
  }

  @media (min-width: 40rem) {
    .services {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 60rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      grid-template-areas: 'copy sign' 'actions sign';
      grid-template-rows: auto 1fr;
      gap: var(--space-6) var(--space-8);
    }

    .hero__actions {
      align-self: start;
    }

    /* Tall posts carry the board above the landscape and leave the text clear of it. */
    .hero__sign {
      --post-height: clamp(9rem, 17vw, 16rem);
      align-self: end;
      justify-self: end;
    }

    .corporate__sign {
      grid-template-columns: 1fr auto;
    }
  }
</style>
