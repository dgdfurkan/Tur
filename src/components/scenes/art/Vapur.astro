---
import { ink } from '../palette';
import Birds from '../parts/Birds.astro';
import Cloud from '../parts/Cloud.astro';
---

<rect width="320" height="200" fill={ink.skyDay}></rect>
<Cloud x={250} y={40} scale={1.2} />
<Birds x={44} y={56} />
<path d="M0 118q70-22 150-12t170-16v40H0z" fill={ink.farGreen}></path>
<!-- Smoke -->
<g fill={ink.haze}>
  <circle cx="148" cy="38" r="12"></circle>
  <circle cx="130" cy="26" r="9"></circle>
  <circle cx="114" cy="18" r="6"></circle>
  <circle cx="160" cy="52" r="8"></circle>
</g>
<!-- Masts and rigging -->
<g fill={ink.woodDeep}>
  <rect x="92" y="54" width="3" height="66"></rect>
  <rect x="232" y="60" width="3" height="60"></rect>
</g>
<path
  d="M93 56l-44 62M93 56l70 40M233 62l-66 36M233 62l44 56"
  fill="none"
  stroke={ink.woodDeep}
  stroke-width="0.9"
></path>
<path d="M236 62h18v11h-18z" fill={ink.red}></path>
<!-- Funnel -->
<rect x="156" y="62" width="20" height="44" fill={ink.dark}></rect>
<rect x="156" y="72" width="20" height="8" fill={ink.red}></rect>
<!-- Superstructure -->
<rect x="110" y="98" width="110" height="24" fill={ink.wall}></rect>
<rect x="124" y="88" width="50" height="12" fill={ink.wallShade}></rect>
<g fill={ink.glass}>
  <circle cx="124" cy="110" r="3.5"></circle>
  <circle cx="142" cy="110" r="3.5"></circle>
  <circle cx="160" cy="110" r="3.5"></circle>
  <circle cx="178" cy="110" r="3.5"></circle>
  <circle cx="196" cy="110" r="3.5"></circle>
</g>
<!-- Hull -->
<path d="M34 120h252l-20 38H64z" fill={ink.dark}></path>
<path d="M58 148h214l-6 10H64z" fill={ink.red}></path>
<rect x="34" y="118" width="252" height="4" fill={ink.wall}></rect>
<!-- Sea -->
<rect x="0" y="154" width="320" height="46" fill={ink.sea}></rect>
<path d="M0 154q20-8 40 0t40 0 40 0 40 0 40 0 40 0 40 0 40 0v10H0z" fill={ink.seaDeep}></path>
<g fill={ink.foam} opacity="0.75">
  <rect x="20" y="174" width="34" height="2.4" rx="1.2"></rect>
  <rect x="120" y="182" width="40" height="2.4" rx="1.2"></rect>
  <rect x="226" y="172" width="36" height="2.4" rx="1.2"></rect>
  <rect x="70" y="190" width="28" height="2.4" rx="1.2"></rect>
  <rect x="264" y="190" width="30" height="2.4" rx="1.2"></rect>
</g>
